---
import Base from '../layouts/Base.astro';
import TresCamadas from '../components/TresCamadas.astro';
import CicloFases from '../components/CicloFases.astro';
import ModosConducao from '../components/ModosConducao.astro';
import Contato from '../components/Contato.astro';
import Externo from '../components/Externo.astro';
import { externos } from '../data/externos';

const numeros = [
  { valor: 270, rotulo: 'testes do núcleo, zero falhando', prova: 'npm --prefix core test' },
  { valor: 7, rotulo: 'canários de comportamento', prova: 'ork eval --so-canarios' },
  { valor: 17, rotulo: 'skills finas com corpus próprio', prova: 'ork eval --so-skills' },
  { valor: 87, rotulo: 'casos de corpus, 174 asserções', prova: 'ork eval --so-skills' },
  { valor: 2, rotulo: 'runtimes homologados: claude-bg e codex', prova: 'ork doctor' },
  { valor: 0, rotulo: 'dependências de runtime no núcleo', prova: 'cat core/package.json' }
];

const principios = [
  {
    titulo: 'Evidência antes de crença',
    texto: 'Self-report de agente não vale. Toda alegação carrega o comando que a comprova, e o comando é reexecutado no HEAD real.'
  },
  {
    titulo: 'Pausa humana no lugar certo',
    texto: 'Você escolhe quanta pausa quer, de seis a nenhuma. O que nunca muda é a verificação.'
  },
  {
    titulo: 'Lacuna publicada como lacuna',
    texto: 'O que não existe é dito com todas as letras. Número inventado não entra no ledger, e uma lacuna nunca vira zero.'
  },
  {
    titulo: 'Contexto com origem',
    texto: 'O Company Brain liga portfólio, decisões, fases e evidências sem transformar memória em autorização ou opinião em fato.'
  }
];
---

<Base
  titulo="Orkastery · Software com IA, conduzido como uma orquestra"
  descricao="A Orkastery é uma organização de código aberto para quem cria software e agentes com IA: condução verificável, evidência antes de crença e um score humano em toda entrega."
>
  <!-- HERO -->
  <section class="hero" data-brasa>
    <canvas class="batuta" data-batuta aria-hidden="true"></canvas>
    <div class="container hero-conteudo">
      <p class="micro-rotulo hero-selo revela">organização de código aberto · licença MIT</p>

      <h1 class="display hero-titulo">
        <span class="revela-corte"><span>Agentes ficaram bons.</span></span>
        <span class="revela-corte" style="--atraso: 0.12s"><span>Conduzir agentes, <em>não</em>.</span></span>
      </h1>

      <p class="paragrafo hero-sub revela" style="--atraso: 0.32s">
        Você conduz. A Orkastery é uma fábrica de software de agentes de IA que prova o
        próprio trabalho: threads em paralelo, resultado verificado e decisão curta só
        quando importa.
      </p>

      <div class="hero-acoes revela" style="--atraso: 0.44s">
        <a class="botao botao-latao" href="/ork/">
          Conheça o Ork
          <svg class="seta" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M2 7h9M7.5 3.5 11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <Externo destino="orkastery" class="botao botao-fantasma">Ver no GitHub</Externo>
      </div>

      <p class="hero-rodape mono revela" style="--atraso: 0.56s">
        <span class="rodape-luz" aria-hidden="true"></span>
        o método e o código são públicos, e cada entrega traz a prova
      </p>
    </div>

    <a class="hero-descida" href="#manifesto-titulo" aria-label="Ir para o manifesto">
      <span class="descida-fio" aria-hidden="true"></span>
      <span class="mono descida-rotulo">role</span>
    </a>

    <div class="hero-veu" aria-hidden="true"></div>
  </section>

  <!-- MANIFESTO -->
  <section class="secao secao-manifesto" aria-labelledby="manifesto-titulo">
    <div class="container">
      <div class="manifesto">
        <h2 class="display manifesto-titulo" id="manifesto-titulo">
          <span class="revela-corte"><span>Aponte três agentes para o mesmo repositório</span></span>
          <span class="revela-corte manifesto-linha2" style="--atraso: 0.1s"><span>e você recebe três agentes se atropelando,</span></span>
          <span class="revela-corte manifesto-linha3" style="--atraso: 0.2s"><span>e um relatório dizendo que <em>deu tudo certo</em>.</span></span>
        </h2>

        <div class="manifesto-colunas">
          <p class="paragrafo revela">
            O problema real não é o agente. É que não existe ninguém entre você e ele:
            ninguém que segure um roadmap, isole loops paralelos, sirva uma pausa humana
            antes do passo irreversível, serialize o merge e reexecute a alegação para ver
            se ela sobrevive fora do texto do modelo.
          </p>
          <p class="paragrafo revela" style="--atraso: 0.1s">
            Esse papel está vago. A Orkastery existe para ocupar ele: uma organização de
            código aberto para quem cria soluções, software e agentes, com IA. O método é
            público, o código é MIT e cada mudança do próprio núcleo entra com as claims
            reexecutadas no CI, à vista de quem abre o pull request.
          </p>
        </div>
      </div>

      <ul class="principios">
        {principios.map((principio, indice) => (
          <li class="painel principio revela" style={`--atraso: ${indice * 0.09}s`}>
            <span class="principio-ordem mono" aria-hidden="true">{String(indice + 1).padStart(2, '0')}</span>
            <h3>{principio.titulo}</h3>
            <p>{principio.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TRES CAMADAS -->
  <section class="secao secao-camadas" aria-labelledby="camadas-titulo">
    <div class="container grade-camadas grade-flexivel">
      <div class="camadas-texto">
        <p class="micro-rotulo revela">arquitetura · engenharia · runtimes</p>
        <h2 class="display revela" id="camadas-titulo" style="--atraso: 0.06s">A Orquestra que transforma ideias em Produto</h2>
        <p class="paragrafo revela" style="--atraso: 0.12s">
          Você é o maestro: desenha a visão e decide os limites da obra. O <code>ork</code>
          é a orquestra, uma AI Software Factory com ciclos de engenharia que garantem precisão, paralelismo e qualidade a cada etapa.
          Os runtimes escrevem o código e fazem a sinfonia soar. Sua intenção conduz;
          nenhuma entrega sobe sem verificação.
        </p>
        <a class="ligacao revela" style="--atraso: 0.18s" href="/ork/">
          Ver a arquitetura completa do Ork
          <svg class="seta" width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M2 7h9M7.5 3.5 11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <div class="revela" style="--atraso: 0.14s">
        <TresCamadas />
      </div>
    </div>
  </section>

  <!-- CICLO -->
  <section class="secao" aria-labelledby="ciclo-titulo">
    <div class="container">
      <div class="cabeca-secao luz-palco">
        <p class="micro-rotulo revela">a looping thread</p>
        <h2 class="display revela" id="ciclo-titulo" style="--atraso: 0.06s">Seis fases que nenhum agente pula</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Toda demanda vira uma looping thread: um ciclo fechado com worktree própria,
          ledger próprio e score próprio. Toque em cada fase para ver o contrato dela.
        </p>
      </div>
      <div class="revela" style="--atraso: 0.2s">
        <CicloFases />
      </div>
    </div>
  </section>

  <!-- MODOS DE CONDUCAO -->
  <section class="secao" aria-labelledby="modos-titulo">
    <div class="container">
      <div class="cabeca-secao luz-palco">
        <p class="micro-rotulo revela">modos de condução</p>
        <h2 class="display revela" id="modos-titulo" style="--atraso: 0.06s">
          Quanta pausa você quer? Escreva uma #TAG.
        </h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Quatro modos cobrem o espectro, do que mais pausa para a sua decisão ao mais
          leve. O que muda é onde o ciclo espera por você. Toque num modo para ver
          quando usar cada um.
        </p>
      </div>
      <div class="revela" style="--atraso: 0.2s">
        <ModosConducao />
      </div>
    </div>
  </section>

  <!-- NUMEROS -->
  <section class="secao secao-numeros" aria-labelledby="numeros-titulo">
    <div class="numeros-aura paralaxe" data-paralaxe="24" aria-hidden="true"></div>
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">medido, não estimado</p>
        <h2 class="display revela" id="numeros-titulo" style="--atraso: 0.06s">Não peça para acreditar. Rode.</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Cada número desta seção vem com o comando que o comprova, medido nesta árvore e
          não estimado. Passe o ponteiro para copiar o comando.
        </p>
      </div>

      <ul class="grade-numeros">
        {numeros.map((numero, indice) => (
          <li class="numero revela" style={`--atraso: ${indice * 0.06}s`}>
            <p class="numero-valor numeral"><span data-contador={numero.valor}>{numero.valor}</span></p>
            <p class="numero-rotulo">{numero.rotulo}</p>
            <div class="numero-prova">
              <code class="mono">{numero.prova}</code>
              <button class="copiar numero-copiar" type="button" data-copiar={numero.prova}>copiar</button>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ECOSSISTEMA -->
  <section class="secao" aria-labelledby="ecossistema-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">três repositórios, um método</p>
        <h2 class="display revela" id="ecossistema-titulo" style="--atraso: 0.06s">O ecossistema Orkastery</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
      </div>

      <div class="bento">
        <a class="painel painel-latao cartao-link bento-grande revela" href="/ork/">
          <p class="micro-rotulo">o produto</p>
          <h3 class="bento-titulo">Ork · AI Software Factory</h3>
          <p class="bento-desc">O motor de orquestração para fábricas de software
          autônomas: N looping threads em paralelo, seis fases, quatro modos de condução e
          a prova de cada entrega.</p>
          <p class="bento-chamada mono">
            <span>npm install -g @orkastery/cli</span>
            {!externos.npm.aberto && <small class="selo-em-breve">em breve</small>}
            <svg class="seta" width="15" height="15" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M2 7h9M7.5 3.5 11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </p>
        </a>

        <a class="painel cartao-link bento-medio revela" style="--atraso: 0.08s" href="/orkmind/">
          <p class="micro-rotulo micro-rotulo-patina">a memória</p>
          <h3 class="bento-titulo">OrkMind</h3>
          <p class="bento-desc">O Company Brain governado e sua Biblioteca: memória,
          documentos e portfólio com tipo, coleção, origem e acesso explícitos.</p>
        </a>
      </div>
    </div>
  </section>

  <Contato />
</Base>

<style is:global>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(120% 92% at 50% 118%, rgba(224, 178, 100, 0.2), transparent 60%),
      radial-gradient(70% 55% at 82% 6%, rgba(111, 185, 168, 0.05), transparent 58%),
      var(--poco);
  }

  .brasa-gl,
  .brasa-pontos {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* O shader entra por fade quando o primeiro quadro fica pronto:
     nada de um retangulo preto piscando antes da luz existir. */
  .brasa-gl {
    opacity: 0;
    transition: opacity 1.1s var(--curva);
  }

  .hero[data-brasa-estado='pronto'] .brasa-gl {
    opacity: 1;
  }

  .brasa-pontos {
    mix-blend-mode: screen;
  }
</style>

<style>
  /* ---------- hero ---------- */

  /* O veu fecha a secao sem apagar a brasa: o preto so chega no ultimo quarto. */
  .hero-veu {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 26%;
    background: linear-gradient(to bottom, transparent, rgba(10, 9, 8, 0.5) 58%, var(--poco));
    pointer-events: none;
  }

  .hero-conteudo {
    position: relative;
    z-index: 2;
    padding-top: 72px;
  }

  .hero-selo {
    margin-bottom: 1.6rem;
  }

  .hero-titulo {
    max-width: 15ch;
  }

  .hero-titulo > span {
    display: block;
  }

  .hero-titulo em {
    color: var(--latao-claro);
  }

  .hero-sub {
    margin-top: 1.8rem;
    font-size: clamp(1.08rem, 1.7vw, 1.32rem);
    max-width: 44ch;
    color: var(--tinta-2);
  }

  .hero-acoes {
    margin-top: 2.6rem;
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero-rodape {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin-top: 2.6rem;
    font-size: var(--t-nano);
    color: var(--tinta-3);
    letter-spacing: 0.04em;
  }

  .rodape-luz {
    width: 5px;
    height: 5px;
    margin-top: 0.5em;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--patina);
    box-shadow: 0 0 10px rgba(111, 185, 168, 0.7);
  }

  /* Convite de rolagem: um fio que desce sozinho, e some ao chegar embaixo */
  .hero-descida {
    position: absolute;
    left: 50%;
    bottom: 2.2rem;
    z-index: 3;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--tinta-3);
    transition: color var(--dur-2) var(--curva);
  }

  .hero-descida:hover {
    color: var(--latao);
  }

  .descida-fio {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, var(--linha-viva));
    position: relative;
    overflow: hidden;
  }

  .descida-fio::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 14px;
    background: linear-gradient(to bottom, transparent, var(--latao));
    animation: descer 2.4s var(--curva-suave) infinite;
  }

  @keyframes descer {
    0% {
      transform: translateY(-100%);
    }
    70%,
    100% {
      transform: translateY(300%);
    }
  }

  .descida-rotulo {
    font-size: var(--t-nano);
    text-transform: uppercase;
    letter-spacing: 0.24em;
  }

  /* ---------- manifesto ---------- */

  .secao-manifesto {
    position: relative;
  }

  .manifesto-titulo {
    max-width: 100%;
    font-size: clamp(1.6rem, 3.6vw, 2.8rem);
    line-height: 1.14;
  }

  .manifesto-titulo > span {
    display: block;
  }

  .manifesto-titulo em {
    color: var(--latao-claro);
  }

  .manifesto-linha2 {
    padding-left: clamp(0rem, 6vw, 4rem);
  }

  .manifesto-linha3 {
    padding-left: clamp(0rem, 12vw, 8rem);
  }

  .manifesto-colunas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin-top: 3.2rem;
  }

  /* ---------- principios ---------- */

  .principios {
    list-style: none;
    padding: 0;
    margin: 4.8rem 0 0;
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    gap: 1.1rem;
  }

  .principio {
    padding-top: 3.2rem;
  }

  .principio-ordem {
    position: absolute;
    top: 1.5rem;
    left: clamp(1.5rem, 3vw, 2.3rem);
    font-size: var(--t-nano);
    color: var(--tinta-3);
    letter-spacing: 0.18em;
    transition: color var(--dur-2) var(--curva);
  }

  .principio:hover .principio-ordem {
    color: var(--latao);
  }

  .principio h3 {
    font-size: 1.16rem;
    max-width: 18ch;
  }

  .principio p {
    margin-top: 0.7rem;
    color: var(--tinta-2);
    font-size: var(--t-small);
  }

  /* ---------- camadas ---------- */

  .secao-camadas {
    background: linear-gradient(to bottom, var(--poco), var(--palco) 32%, var(--poco));
  }

  .grade-camadas {
    display: grid;
    grid-template-columns: 1fr 1.28fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .camadas-texto h2 {
    margin-top: 0.9rem;
  }

  .camadas-texto .paragrafo {
    margin-top: 1.3rem;
  }

  .camadas-texto .ligacao {
    margin-top: 1.9rem;
  }

  /* ---------- numeros ---------- */

  .secao-numeros {
    position: relative;
    overflow: hidden;
    background: var(--palco);
    border-block: 1px solid var(--linha);
  }

  .numeros-aura {
    position: absolute;
    inset: -20% 0;
    pointer-events: none;
    background:
      radial-gradient(50% 55% at 12% 92%, rgba(224, 178, 100, 0.09), transparent 62%),
      radial-gradient(42% 46% at 92% 8%, rgba(111, 185, 168, 0.05), transparent 64%);
  }

  .secao-numeros .container {
    position: relative;
  }

  .grade-numeros {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.6rem 2rem;
  }

  .numero {
    padding-top: 1.4rem;
    border-top: 1px solid var(--linha);
    transition: border-color var(--dur-3) var(--curva);
  }

  .numero:hover {
    border-top-color: var(--latao-linha);
  }

  .numero-valor {
    font-size: clamp(2.8rem, 6.2vw, 4.4rem);
    color: var(--latao);
  }

  .numero-rotulo {
    margin-top: 0.5rem;
    color: var(--tinta);
    font-variation-settings: 'wght' 500;
    max-width: 24ch;
  }

  .numero-prova {
    margin-top: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .numero-prova code {
    font-size: var(--t-nano);
    color: var(--tinta-3);
    background: none;
    border: none;
    padding: 0;
    white-space: nowrap;
  }

  .numero-prova code::before {
    content: '$ ';
    color: var(--latao);
  }

  /* O botao de copiar so aparece quando o cartao e visitado */
  .numero-copiar {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--dur-2) var(--curva), transform var(--dur-2) var(--curva),
      color var(--dur-2) var(--curva), border-color var(--dur-2) var(--curva);
  }

  .numero:hover .numero-copiar,
  .numero-copiar:focus-visible,
  .numero-copiar[data-copiado='sim'] {
    opacity: 1;
    transform: none;
  }

  /* ---------- bento ---------- */

  .bento {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 1.1rem;
  }

  .bento-grande {
    display: flex;
    flex-direction: column;
  }

  .bento-titulo {
    margin-top: 0.85rem;
  }

  .bento-grande .bento-titulo {
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    font-variation-settings: 'opsz' 90, 'wght' 600, 'SOFT' 0, 'WONK' 0;
  }

  .bento-desc {
    margin-top: 0.85rem;
    color: var(--tinta-2);
    font-size: var(--t-small);
    max-width: 44ch;
  }

  .bento-chamada {
    margin-top: auto;
    padding-top: 2.2rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--latao);
    font-size: var(--t-micro);
  }

  .bento-chamada span::before {
    content: '$ ';
    opacity: 0.65;
  }

  .bento-grande:hover .seta {
    transform: translateX(4px);
  }

  .seta {
    transition: transform var(--dur-2) var(--curva);
  }

  /* ---------- responsivo ---------- */

  @media (max-width: 960px) {
    .grade-camadas {
      grid-template-columns: 1fr;
    }

    .principios {
      grid-template-columns: 1fr;
    }

    .manifesto-colunas {
      grid-template-columns: 1fr;
    }

    .grade-numeros {
      grid-template-columns: repeat(2, 1fr);
    }

    .bento {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .bento-grande {
      grid-row: auto;
    }

    .numero-copiar {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 520px) {
    .grade-numeros {
      grid-template-columns: 1fr;
    }

    .hero-descida {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .descida-fio::after {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/brasa.ts';
  import '../scripts/batuta.ts';
