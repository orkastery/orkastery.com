---
import Base from '../../layouts/Base.astro';
import Externo from '../../components/Externo.astro';
import type { Destino } from '../../data/externos';

const repos: { nome: string; desc: string; destino: Destino }[] = [
  { nome: 'Orkastery/OrkMind', desc: 'o núcleo da memória', destino: 'orkmind' },
  { nome: 'Orkastery/orkmind-web', desc: 'a interface web', destino: 'orkmindWeb' }
];

const pilares = [
  { titulo: 'Biblioteca compreensível', texto: 'Tipo diz o que algo é; coleção organiza a memória; origem mostra de onde veio.' },
  { titulo: 'Acesso governado', texto: 'A identidade vem do transporte autenticado e a ACL é revalidada em cada leitura.' },
  { titulo: 'Histórico recuperável', texto: 'Escritas usam revisão esperada, versões append-only, receipts, reconciliação e rollback.' }
];
---

<Base
  titulo="OrkMind · O Company Brain do ecossistema Orkastery"
  descricao="OrkMind conecta conhecimento, decisões e execução empresarial com identidade, proveniência e acesso governados."
>
  <section class="ponte">
    <div class="ponte-aura paralaxe" data-paralaxe="16" aria-hidden="true"></div>
    <div class="ponte-malha" aria-hidden="true"></div>

    <div class="container ponte-conteudo">
      <p class="micro-rotulo micro-rotulo-patina revela">orkmind · memory layer</p>

      <h1 class="display ponte-titulo">
        <span class="revela-corte"><span>Conhecimento que vira</span></span>
        <span class="revela-corte" style="--atraso: 0.1s"><span><em>contexto confiável</em></span></span>
      </h1>

      <p class="paragrafo ponte-sub revela" style="--atraso: 0.28s">
        O OrkMind é o Company Brain do ecossistema: conecta o que a empresa sabe,
        decide e entrega. O Ork recebe contexto citável; a Biblioteca em <code>/knowledge</code>
        reúne memória, documentos e entidades reais sem misturar tipo, coleção, fonte ou autoridade.
      </p>

      <ul class="pilares escalona" style="--atraso: 0.34s">
        {pilares.map((pilar) => (
          <li class="pilar">
            <span class="pilar-marca" aria-hidden="true"></span>
            <p class="pilar-titulo">{pilar.titulo}</p>
            <p class="pilar-texto">{pilar.texto}</p>
          </li>
        ))}
      </ul>

      <div class="ponte-acoes revela" style="--atraso: 0.4s">
        <a class="botao botao-latao" href="https://orkmind.com" rel="noopener">
          Visitar o site do OrkMind
          <svg class="seta" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M2 7h9M7.5 3.5 11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="botao botao-fantasma" href="/ork/">Ver o Ork, que usa a memória</a>
      </div>

      <ul class="ponte-repos revela" style="--atraso: 0.48s">
        {repos.map((repo) => (
          <li>
            <Externo destino={repo.destino} class="repo">
              <span class="repo-nome mono">{repo.nome}</span>
              <span class="repo-desc">{repo.desc}</span>
              <svg class="repo-fuga" width="13" height="13" viewBox="0 0 13 13" aria-hidden="true">
                <path d="M3.5 9.5 9.5 3.5M5 3.5h4.5V8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </Externo>
          </li>
        ))}
      </ul>

      <p class="ponte-nota paragrafo revela" style="--atraso: 0.56s">
        No corte C1, o mesmo portfólio <code>prod → proj → init</code>, as fases,
        decisões, claims e artefatos podem ser encontrados no Brain nos quatro hosts.
        A Biblioteca mostra produtos, projetos e iniciativas como tipos ontológicos, mesmo sem
        coleção; fatos técnicos opacos ficam disponíveis por filtro. A ontologia empresarial
        ampla, Atlas e cuidadores continuam no C2, não são anunciados como entregues.
      </p>
    </div>
  </section>
</Base>

<style>
  .ponte {
    position: relative;
    min-height: calc(100dvh - 72px);
    display: flex;
    align-items: center;
    padding-top: 72px;
    overflow: hidden;
  }

  /* A patina lidera aqui: a memoria e a camada fria do ecossistema */
  .ponte-aura {
    position: absolute;
    inset: -20% 0;
    pointer-events: none;
    background:
      radial-gradient(48% 52% at 80% 22%, rgba(111, 185, 168, 0.12), transparent 62%),
      radial-gradient(40% 42% at 12% 88%, rgba(224, 178, 100, 0.08), transparent 64%);
  }

  /* Malha de memoria: pontos ligados, quase apagados */
  .ponte-malha {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, rgba(165, 219, 207, 0.16) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(70% 65% at 72% 30%, #000, transparent 76%);
    -webkit-mask-image: radial-gradient(70% 65% at 72% 30%, #000, transparent 76%);
  }

  .ponte-conteudo {
    position: relative;
    z-index: 2;
    padding-block: 4.5rem;
  }

  .ponte-titulo {
    max-width: 14ch;
    margin-top: 1.1rem;
  }

  .ponte-titulo > span {
    display: block;
  }

  .ponte-titulo em {
    color: var(--patina-clara);
  }

  .ponte-sub {
    margin-top: 1.6rem;
    max-width: 50ch;
    font-size: clamp(1.06rem, 1.7vw, 1.28rem);
  }

  /* ---------- pilares ---------- */

  .pilares {
    list-style: none;
    padding: 0;
    margin: 2.8rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
    max-width: 54rem;
  }

  .pilar {
    padding-top: 1.1rem;
    border-top: 1px solid var(--linha);
    transition: border-color var(--dur-3) var(--curva);
  }

  .pilar:hover {
    border-top-color: var(--patina-linha);
  }

  .pilar-marca {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--patina);
    box-shadow: 0 0 10px rgba(111, 185, 168, 0.6);
    margin-bottom: 0.85rem;
  }

  .pilar-titulo {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 26, 'wght' 600, 'SOFT' 0, 'WONK' 0;
    font-size: 1.05rem;
    letter-spacing: -0.012em;
    color: var(--tinta);
  }

  .pilar-texto {
    margin-top: 0.45rem;
    color: var(--tinta-3);
    font-size: var(--t-small);
  }

  /* ---------- acoes ---------- */

  .ponte-acoes {
    margin-top: 2.8rem;
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  /* ---------- repos ---------- */

  .ponte-repos {
    list-style: none;
    padding: 0;
    margin: 2.8rem 0 0;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .repo {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.25rem 1rem;
    text-decoration: none;
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-superficie);
    padding: 1rem 1.4rem;
    background: linear-gradient(180deg, rgba(245, 241, 234, 0.03), transparent), var(--palco);
    box-shadow: var(--lustro);
    transition: border-color var(--dur-2) var(--curva), transform var(--dur-2) var(--curva),
      box-shadow var(--dur-2) var(--curva);
  }

  .repo:hover {
    border-color: var(--patina-linha);
    transform: translateY(-3px);
    box-shadow: var(--lustro), var(--sombra-2);
  }

  .repo-nome {
    color: var(--patina);
    font-size: var(--t-small);
  }

  .repo-desc {
    grid-column: 1;
    color: var(--tinta-3);
    font-size: var(--t-nano);
  }

  .repo-fuga {
    grid-row: 1 / 3;
    grid-column: 2;
    color: var(--tinta-3);
    transition: color var(--dur-2) var(--curva), transform var(--dur-2) var(--curva);
  }

  .repo:hover .repo-fuga {
    color: var(--patina);
    transform: translate(2px, -2px);
  }

  .ponte-nota {
    margin-top: 2.8rem;
    font-size: var(--t-small);
    max-width: 56ch;
  }

  @media (max-width: 780px) {
    .pilares {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
  }
</style>
