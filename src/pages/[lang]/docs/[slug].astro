---
import Docs from '../../../layouts/Docs.astro';
import DocsDiagram from '../../../components/DocsDiagram.astro';
import catalog from '../../../data/docs-catalog';
import {localeFor} from '../../../data/i18n';
export function getStaticPaths(){
 const modules=import.meta.glob('../../../data/docs-*.ts',{eager:true});
 const articles=catalog.modules.flatMap(file=>modules['../../../data/'+file].default);
 return ['en','es'].flatMap(lang=>articles.map(article=>({params:{lang,slug:article.slug},props:{article}})));
}
const {article}=Astro.props,locale=localeFor(Astro.url.pathname);
const aliases={mapa:'arquitetura',entrega:'ciclo',atencao:'mod-04',resiliencia:'mod-03',servicos:'mod-06',contratos:'contratos',valor:'contratos'};
---
<Docs slug={article.slug} aliases={article.slug==='arquitetura'?aliases:{}}>
 {article.diagram&&<DocsDiagram name={article.diagram} {locale}/>}
 {article.slug==='arquitetura'&&<DocsDiagram name="isolation" {locale}/>}
</Docs>
