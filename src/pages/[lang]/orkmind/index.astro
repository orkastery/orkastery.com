---
import ProductPage from '../../../components/ProductPage.astro';
import products from '../../../data/product-pages';
import {localeFor} from '../../../data/i18n';
export function getStaticPaths(){return ['en'].map(lang=>({params:{lang}}));}
const locale=localeFor(Astro.url.pathname);
---
<ProductPage content={products.orkmind[locale]} product="OrkMind" diagram={false} docsBase="https://orkmind.com" repository="https://github.com/orkastery/orkmind"/>
