---
import HomePage from '../../../components/HomePage.astro';
import products from '../../../data/product-pages';
import {localeFor} from '../../../data/i18n';
export function getStaticPaths(){return ['en','es'].map(lang=>({params:{lang}}));}
const locale=localeFor(Astro.url.pathname);
---
<HomePage content={products.orkmind[locale]} product="OrkMind" diagram={false} docsBase="https://orkmind.com" repository="https://github.com/orkastery/orkmind"/>
