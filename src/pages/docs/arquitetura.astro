---
// OnePager de arquitetura do Orkastery: camadas, blocos funcionais, servicos, contratos e o
// porque. Cada bloco aponta para a pagina canonica do produto no repositorio (docs/produto),
// que o `ork docs verificar` confere contra o codigo em todo PR.
import Base from '../../layouts/Base.astro';
import { externos } from '../../data/externos';

// Enquanto o repositorio nao abre, os links para as paginas canonicas ficam sem destino (texto,
// sem seta) e o rodape avisa que abrem em breve. Ver src/data/externos.ts.
const aberto = externos.orkastery.aberto;
const REPO = `${externos.orkastery.url}/blob/main`;
const produto = (arquivo: string) => (aberto ? `${REPO}/docs/produto/${arquivo}` : undefined);
const roadmap = (arquivo: string) => (aberto ? `${REPO}/docs/roadmap/${arquivo}` : undefined);
const fuga = aberto ? ' ↗' : '';

const promessas = [
  ['Nada vale por relato', 'Toda afirmação do agente vira claim com comando e é reexecutada no commit real, e de novo num runner limpo.'],
  ['Você só é chamado quando importa', 'Um resumo por hora, perguntas em lotes de cinco com uma recomendada, e o óbvio chega decidido.'],
  ['A fábrica não para', 'Conta esgotada, login perdido ou rate limit: o mesmo prompt segue em outro perfil, outro runtime ou na fila.'],
  ['A documentação não mente', 'Produto e roadmap vivem no repositório e reprovam o PR quando divergem do código ou do git.'],
];

const canais = [
  ['Você, o Product Builder', 'decide o quê e o porquê; nunca o como de rotina'],
  ['Telegram', 'via Hermes ou OpenClaw, com ingresso autenticado'],
  ['Claude Code', '/orkastery:ork, MCP local'],
  ['Codex', '$ork, MCP local'],
];

const hosts = [
  ['Plugin Claude Code', 'skills, subagentes de fase, hooks'],
  ['Skills Codex', 'catálogo de condução no projeto'],
  ['Plugin Hermes', 'roteador fino e ingresso HITL'],
  ['Extensão OpenClaw', 'tools ork_*, uma por comando'],
  ['Servidor MCP', 'ork mcp serve, stdio'],
];

const modulos = [
  {
    id: 'MOD-01', nome: 'Condução', arquivo: 'MOD-01-conducao-de-threads.md', cor: 'latao',
    blocos: ['Thread e 6 fases', 'Modos #Classic · #Maestro · #Auto · #Fast', 'Despacho com prompt + sha256', 'Setup por bloco', 'Onboarding', 'Portfólio prod → proj → init'],
  },
  {
    id: 'MOD-02', nome: 'Verdade e entrega', arquivo: 'MOD-02-verdade-e-entrega.md', cor: 'patina',
    blocos: ['Claims com comando', 'Verify no HEAD real', 'CI como CHECK independente', 'Ship com push provado', 'Worktrees e leases', 'Auditoria e dívida'],
  },
  {
    id: 'MOD-03', nome: 'Runtimes e contas', arquivo: 'MOD-03-runtimes-e-contas.md', cor: 'brasa',
    blocos: ['Registro de runtimes', 'Rodízio de contas', 'Fallback por bloco', 'Retry tipado', 'Fila de rate limit', 'Sensores de sessão'],
  },
  {
    id: 'MOD-04', nome: 'Atenção humana', arquivo: 'MOD-04-atencao-humana.md', cor: 'latao',
    blocos: ['Resumo por hora', 'Lote a–d com recomendada', 'Decisão tomada e informada', 'Horário do dono', 'Monitor, board e pulse', 'MASTER com índice'],
  },
  {
    id: 'MOD-05', nome: 'Memória e registro', arquivo: 'MOD-05-memoria-e-registro.md', cor: 'patina',
    blocos: ['Handoff triado', 'Recall no momento certo', 'Memória OrkMind', 'Telemetria do ledger', 'Documentação como código', 'Company Brain no CLI'],
  },
];

const execucao = [
  ['claude-bg', 'Claude Code em segundo plano; a sessão aparece em claude agents'],
  ['codex', 'codex exec headless na sessão autenticada'],
  ['Perfis de conta', 'um diretório por conta; o login é do próprio CLI'],
];

const fundacoes = [
  ['git', 'worktree e branch por thread; merge serializado'],
  ['Ledger', 'append-only por thread; decisão e correção são eventos novos'],
  ['Contratos ork.*/vN', 'JSON versionado; leitor antigo aceita para sempre'],
  ['GitHub Actions', 'o CHECK independente no SHA exato'],
  ['OrkMind', 'opcional: memória do tenant em Postgres com pgvector'],
];

const transversais = [
  ['Segurança e proveniência', 'HMAC em toda resposta humana · só assinatura, nunca chave paga · o ork nunca lê credencial'],
  ['Observabilidade', 'ledger · telemetria econômica · monitor que só lê'],
  ['Governança', '18 motivos tipados · policies · leases · o modo nunca afrouxa a verificação'],
];

const passos = [
  ['Pedido', 'Você escreve o resultado e a #TAG, no canal que preferir.', 'ork modos --do-pedido'],
  ['GOAL · PLAN', 'Objetivo, critério de pronto executável e tarefas com verify. Decisão óbvia é registrada, não perguntada.', 'ork decisao registrar'],
  ['GO', 'O runtime certo trabalha na worktree da thread; conta esgotada troca de perfil sem parar.', 'ork phase run'],
  ['CHECK', 'As claims são reexecutadas no HEAD real e, de novo, no runner do GitHub, no SHA exato.', 'ork verify · ork ci run'],
  ['SHIP', 'Merge serializado por lease; só vale com o SHA que o remoto devolve.', 'ork ship'],
  ['MASTER', 'POSTMORTEM tipado e índice derivado do ledger; ninguém digita nota para a fila andar.', 'ork master'],
  ['Docs', 'O roadmap recebe o commit do merge e a fase da thread, direto do ledger e do git.', 'ork docs sincronizar'],
];

const camadasAtencao = [
  ['Silêncio', 'O que o agente resolve com segurança, ele resolve. Fica no ledger, com o porquê.'],
  ['Resumo por hora', 'Uma mensagem só: pendentes, urgentes, bloqueando uma thread, críticas. E a pergunta: posso mandar agora?'],
  ['Lote', 'Com o seu sim, até cinco perguntas objetivas, cada uma com a–d e uma recomendada.'],
  ['Abertas', 'Até duas, uma de cada vez, sempre depois das objetivas.'],
];

const escada = [
  ['Mesmo perfil', 'rate limit curto: espera a janela na fila durável, com o horário lido do stderr'],
  ['Outro perfil', 'cota ou crédito esgotado: o mesmo prompt, mesmo sha256, na próxima conta com login'],
  ['Outro runtime', 'sem perfil livre: o fallback do bloco (por exemplo Claude → Codex)'],
  ['Fila', 'sem nenhuma saída agora: a fase espera o menor prazo de volta'],
  ['Você', 'só quando a política manda: custo, irreversível ou limite de tentativas'],
];

const servicos = [
  { lugar: 'Máquina da fábrica', itens: ['CLI ork global, compilado da main', 'sessões claude --bg e codex exec, uma por fase', 'estado das threads em .orkastery/ na árvore principal', 'cron do pulse (resumo em camadas)', 'gateways Hermes e OpenClaw (serviços do usuário)'] },
  { lugar: 'GitHub', itens: ['repositório e PRs', 'workflow CI: ork-verify, núcleo em Node 20 e 22, documentação', 'o check no SHA exato é o portão do merge'] },
  { lugar: 'OrkMind (opcional)', itens: ['Postgres com pgvector, uma base por tenant', 'decisões, handoffs, lições e roadmap com proveniência', 'sem ele, a memória degrada para arquivos, com aviso'] },
  { lugar: 'Canal do dono', itens: ['Telegram via bot do Hermes ou do OpenClaw', 'allowlist de remetente e chat', 'resposta vale só com prova HMAC do update'] },
];

const contratos = [
  ['ork.hitl/v2', 'pedido humano com itens decididos e perguntas', 'HITL'],
  ['ork.hitl-lote/v1', 'o lote de até cinco perguntas servido ao dono', 'HITL'],
  ['ork.pulse-consent/v1', 'o "posso mandar agora?" e o código da resposta', 'HITL'],
  ['ork.decisao-autonoma/v1', 'o rastro da decisão tomada pelo agente', 'Condução'],
  ['ork.ci-bundle/v1', 'as claims exportadas para o runner', 'Verdade'],
  ['ork.runtime-profiles/v1', 'perfis de conta, sem segredo', 'Runtimes'],
  ['ork.ledger-stats/v1', 'tempo, tokens, custo e espera por período', 'Registro'],
  ['ork.pulse/v1', 'a fila unificada de atenção', 'Atenção'],
];

const valor = [
  ['O agente diz que terminou', 'claim com comando, reexecutada no HEAD real e no CI', 'o check verde no SHA exato'],
  ['O dono vira o monitor', 'resumo em camadas e lote com recomendação', 'ork decisao placar'],
  ['A conta acaba e o roadmap para', 'rodízio de perfis e fallback de runtime', 'evento runtime_profile_rotated'],
  ['Duas sessões pisam no mesmo arquivo', 'worktree por thread e lease com fila', 'fila FIFO visível em ork board plan'],
  ['A doc diz uma coisa e o código outra', 'páginas com fontes, símbolos e commits conferíveis', 'ork docs verificar no CI'],
];
---

<Base titulo="Arquitetura | Orkastery em uma página" descricao="As camadas, os blocos funcionais, os serviços e os contratos do Orkastery em uma página, e por que nenhuma afirmação de agente vale antes de ser provada.">
  <div class="container arq">
    <header class="arq-hero">
      <p class="docs-label mono">DOCS / ARQUITETURA</p>
      <h1>A fábrica que entrega <span class="destaque">e presta contas.</span></h1>
      <p class="arq-lede">Em uma página: as camadas, os blocos funcionais, os serviços e os contratos do Orkastery. E a regra que atravessa tudo: <strong>nenhuma afirmação de agente vale antes de ser provada</strong>, e o seu tempo só é usado para o que só você pode decidir.</p>
      <ul class="promessas escalona" aria-label="O que o Orkastery garante">
        {promessas.map(([titulo, texto]) => (
          <li><strong>{titulo}</strong><span>{texto}</span></li>
        ))}
      </ul>
      <nav class="arq-indice mono" aria-label="Nesta página">
        <a href="#mapa">01 Mapa</a><a href="#entrega">02 Entrega</a><a href="#atencao">03 Atenção</a><a href="#resiliencia">04 Resiliência</a><a href="#servicos">05 Serviços</a><a href="#contratos">06 Contratos</a><a href="#valor">07 Valor</a>
      </nav>
    </header>

    <section id="mapa" class="arq-secao">
      <p class="docs-label mono">01 · MAPA DA PLATAFORMA</p>
      <h2>Cinco camadas, uma regra: a decisão de negócio mora só no núcleo.</h2>
      <p class="arq-texto">De cima para baixo, o pedido desce como intenção e vira prompt com sha256. De baixo para cima, a evidência sobe como commit e saída de comando e só passa depois de verificada. As faixas da direita valem para todas as camadas.</p>

      <div class="mapa" role="group" aria-label="Mapa da plataforma Orkastery em cinco camadas e três faixas transversais">
        <div class="mapa-camadas">
          <div class="camada camada-pessoas">
            <p class="camada-rotulo mono"><span>Pessoas e canais</span><span class="camada-id">PLAT-01</span></p>
            <ul class="blocos blocos-4">
              {canais.map(([nome, desc]) => <li><strong>{nome}</strong><span>{desc}</span></li>)}
            </ul>
          </div>

          <p class="conector mono" aria-hidden="true"><span>↓ #TAG e pedido</span><span>resumo, lote e entrega ↑</span></p>

          <div class="camada camada-hosts">
            <p class="camada-rotulo mono"><span>Hosts e adaptadores · zero regra de negócio</span><a class="camada-id" href={produto('SYS-02-hosts-e-canais.md')}>SYS-02{fuga}</a></p>
            <ul class="blocos blocos-5">
              {hosts.map(([nome, desc]) => <li><strong>{nome}</strong><span>{desc}</span></li>)}
            </ul>
          </div>

          <p class="conector mono" aria-hidden="true"><span>↓ ork thread new · phase run · gate · ship</span><span>gates tipados · ledger ↑</span></p>

          <div class="camada camada-nucleo">
            <p class="camada-rotulo mono"><span>Núcleo ork · determinístico, nenhum LLM dentro</span><a class="camada-id" href={produto('SYS-01-nucleo-ork.md')}>SYS-01{fuga}</a></p>
            <div class="modulos">
              {modulos.map((m) => (
                <article class={`modulo modulo-${m.cor}`}>
                  <header><a class="mono" href={produto(m.arquivo)}>{m.id}{fuga}</a><h3>{m.nome}</h3></header>
                  <ul>{m.blocos.map((b) => <li>{b}</li>)}</ul>
                </article>
              ))}
            </div>
          </div>

          <p class="conector mono" aria-hidden="true"><span>↓ prompt montado, sha256 no ledger</span><span>commits · diffs · saída de comando ↑</span></p>

          <div class="camada camada-execucao">
            <p class="camada-rotulo mono"><span>Execução · quem escreve o código</span><a class="camada-id" href={produto('MOD-03-runtimes-e-contas.md')}>MOD-03{fuga}</a></p>
            <ul class="blocos blocos-3">
              {execucao.map(([nome, desc]) => <li><strong>{nome}</strong><span>{desc}</span></li>)}
            </ul>
          </div>

          <div class="camada camada-fundacoes">
            <p class="camada-rotulo mono"><span>Fundações e estado</span></p>
            <ul class="blocos blocos-5">
              {fundacoes.map(([nome, desc]) => <li><strong>{nome}</strong><span>{desc}</span></li>)}
            </ul>
          </div>
        </div>

        <aside class="mapa-transversais" aria-label="Faixas transversais">
          {transversais.map(([nome, desc]) => (
            <div class="transversal"><strong>{nome}</strong><span>{desc}</span></div>
          ))}
        </aside>
      </div>
    </section>

    <section id="entrega" class="arq-secao">
      <p class="docs-label mono">02 · UMA ENTREGA DE PONTA A PONTA</p>
      <h2>Do pedido ao roadmap atualizado, sem um passo que dependa de acreditar no agente.</h2>
      <ol class="fluxo escalona">
        {passos.map(([fase, texto, cmd], i) => (
          <li class={i === 3 ? 'fluxo-prova' : ''}>
            <span class="fluxo-n mono">{String(i + 1).padStart(2, '0')}</span>
            <strong>{fase}</strong>
            <span class="fluxo-texto">{texto}</span>
            <code>{cmd}</code>
          </li>
        ))}
      </ol>
      <p class="arq-nota">O CHECK acontece duas vezes, de propósito: na máquina da fábrica e num runner que não herda nada de quem construiu. Onde as duas discordam, vale o runner.</p>
    </section>

    <section id="atencao" class="arq-secao">
      <p class="docs-label mono">03 · ONDE VOCÊ ENTRA</p>
      <h2>Atenção em camadas. O óbvio chega decidido; o resto, em lote.</h2>
      <div class="atencao">
        <ol class="degraus">
          {camadasAtencao.map(([nome, texto], i) => (
            <li style={`--nivel:${i}`}><span class="degrau-n mono">{i}</span><strong>{nome}</strong><span>{texto}</span></li>
          ))}
        </ol>
        <div class="atencao-regras">
          <h3>Regras que não afrouxam</h3>
          <ul>
            <li><strong>Decisão óbvia vem tomada</strong> e informada no próximo resumo, com como mudar e o custo de mudar agora ou depois.</li>
            <li><strong>Prazo vencido espera ou escala</strong>, nunca aprova. Ato irreversível nunca avança por default.</li>
            <li><strong>O agente nunca responde por você.</strong> A resposta só vale com prova HMAC nascida do update autenticado do canal.</li>
            <li><strong>Horário no seu fuso</strong>, em formato brasileiro, dito uma vez por mensagem.</li>
          </ul>
          <a class="arq-link" href={produto('FEAT-011-hitl-em-camadas.md')}>FEAT-011 · HITL em camadas{fuga}</a>
        </div>
      </div>
    </section>

    <section id="resiliencia" class="arq-secao">
      <p class="docs-label mono">04 · POR QUE A FÁBRICA NÃO PARA</p>
      <h2>Uma escada de saídas antes de chegar em você.</h2>
      <ol class="escada">
        {escada.map(([nome, texto], i) => (
          <li style={`--passo:${i}`}><strong>{nome}</strong><span>{texto}</span></li>
        ))}
      </ol>
      <p class="arq-nota">O <code>ork</code> nunca lê, copia ou migra credencial: cada perfil aponta o diretório onde o próprio CLI guarda o login. Chave de API paga no ambiente da fábrica é <code>cost.violation</code>, sem retry. <a class="arq-link" href={produto('FEAT-008-rodizio-de-contas.md')}>FEAT-008{fuga}</a></p>
    </section>

    <section id="servicos" class="arq-secao">
      <p class="docs-label mono">05 · SERVIÇOS E PROCESSOS</p>
      <h2>Onde cada peça roda.</h2>
      <div class="servicos escalona">
        {servicos.map((s) => (
          <article class="servico">
            <h3>{s.lugar}</h3>
            <ul>{s.itens.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section id="contratos" class="arq-secao">
      <p class="docs-label mono">06 · CONTRATOS E ESTADO</p>
      <h2>Os dados que cruzam fronteiras têm contrato versionado.</h2>
      <div class="tabela">
        <table>
          <thead><tr><th>Contrato</th><th>O que carrega</th><th>Bloco</th></tr></thead>
          <tbody>
            {contratos.map(([id, desc, bloco]) => <tr><td><code>{id}</code></td><td>{desc}</td><td>{bloco}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="arq-nota"><strong>Escritores param, leitores aceitam para sempre.</strong> Quando um mecanismo sai do produto, o que já foi gravado com ele continua legível. Ledger, contratos e hashes ficam em UTC ISO; só a superfície humana muda de fuso.</p>
    </section>

    <section id="valor" class="arq-secao">
      <p class="docs-label mono">07 · O QUE SÓ O ORKASTERY FAZ</p>
      <h2>Cada dor tem um mecanismo, e cada mecanismo tem uma prova.</h2>
      <div class="tabela">
        <table class="tabela-valor">
          <thead><tr><th>A dor</th><th>O mecanismo</th><th>A prova</th></tr></thead>
          <tbody>
            {valor.map(([dor, mecanismo, prova]) => <tr><td>{dor}</td><td>{mecanismo}</td><td><code>{prova}</code></td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="metricas">
        <p class="mono">DUAS MÉTRICAS JULGAM QUALQUER MECANISMO</p>
        <p><strong>Entregas por semana sobem.</strong> <strong>Interrupções por semana caem para uma ou duas.</strong> O que não move nenhuma das duas na direção certa sai do produto, com um canário provando que a falha que ele evitava continua evitada.</p>
      </div>
    </section>

    <footer class="arq-fim">
      {aberto ? (
        <p>A fonte de verdade de cada bloco desta página é uma página do repositório, conferida contra o código em todo PR:</p>
      ) : (
        <p>A fonte de verdade de cada bloco desta página é uma página do repositório, conferida contra o código em todo PR. O repositório abre em breve.</p>
      )}
      <p class="arq-fim-links">
        {aberto && <a href={produto('PLAT-01-orkastery.md')}>Plataforma PLAT-01 ↗</a>}
        {aberto && <a href={produto('README.md')}>Índice do produto ↗</a>}
        {aberto && <a href={roadmap('README.md')}>Roadmap ↗</a>}
        <a href="/docs/">Guia do usuário →</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .arq { padding-top: 8rem; padding-bottom: 5rem; color: var(--tinta-2); }
  .docs-label { font-size: 0.875rem; letter-spacing: 0.08em; color: var(--latao); }
  .arq-hero { max-width: 920px; padding-bottom: 2.5rem; border-bottom: 1px solid var(--linha); }
  h1 { font-family: var(--f-display); font-size: clamp(2.5rem, 6vw, 4.8rem); line-height: 1.05; letter-spacing: -0.035em; color: var(--tinta); margin: 1rem 0 1.5rem; }
  .destaque { color: var(--latao); }
  .arq-lede { font-size: 1.125rem; line-height: 1.7; max-width: 62ch; }
  .arq-lede strong, .arq-texto strong, .arq-nota strong { color: var(--tinta); }
  h2 { font-family: var(--f-display); font-size: clamp(1.6rem, 3vw, 2.3rem); line-height: 1.2; letter-spacing: -0.02em; color: var(--tinta); margin: 0.75rem 0 1rem; max-width: 30ch; }
  h3 { font-family: var(--f-display); color: var(--tinta); font-size: 1.15rem; line-height: 1.3; }
  code { font-family: var(--f-mono); font-size: 0.85em; color: var(--latao-claro); overflow-wrap: anywhere; }
  .arq-texto, .arq-nota { max-width: 70ch; line-height: 1.7; margin: 1rem 0; }
  .arq-nota { font-size: 0.95rem; color: var(--tinta-3); }
  .arq-link { color: var(--latao); text-underline-offset: 0.2em; }

  .promessas { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.9rem; }
  .promessas li { display: grid; gap: 0.4rem; padding: 1rem 1.1rem; background: var(--painel); border: 1px solid var(--linha); border-radius: var(--raio-campo); box-shadow: var(--lustro); font-size: 0.92rem; line-height: 1.55; }
  .promessas strong { color: var(--tinta); font-size: 1rem; }
  .arq-indice { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin-top: 2rem; font-size: 0.8rem; }
  .arq-indice a { color: var(--tinta-3); text-decoration: none; }
  .arq-indice a:hover { color: var(--latao); }

  .arq-secao { scroll-margin-top: 100px; padding: 3.5rem 0; border-bottom: 1px solid var(--linha); }

  /* ---------- 01 mapa ---------- */
  .mapa { display: grid; grid-template-columns: minmax(0, 1fr) 210px; gap: 1rem; margin-top: 2rem; }
  .mapa-camadas { display: grid; gap: 0.35rem; min-width: 0; }
  .camada { border: 1px solid var(--linha); border-radius: var(--raio-superficie); padding: 1rem 1.1rem 1.1rem; background: var(--painel); box-shadow: var(--lustro); min-width: 0; }
  .camada-rotulo { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tinta-3); margin-bottom: 0.8rem; }
  .camada-id { color: var(--latao); text-decoration: none; letter-spacing: 0.08em; white-space: nowrap; }
  .blocos { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  .blocos-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .blocos-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .blocos-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
