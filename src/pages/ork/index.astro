---
import Base from '../../layouts/Base.astro';
import Externo from '../../components/Externo.astro';
import { externos } from '../../data/externos';
import CicloFases from '../../components/CicloFases.astro';
import EspectroModos from '../../components/EspectroModos.astro';
import MaquinaVerificacao from '../../components/MaquinaVerificacao.astro';
import ThreadsParalelas from '../../components/ThreadsParalelas.astro';
import GateTokens from '../../components/GateTokens.astro';
import RadarHitl from '../../components/RadarHitl.astro';
import ScoreDial from '../../components/ScoreDial.astro';

const adaptadores = [
  {
    nome: 'claude-code',
    entrega: 'Plugin com skills, subagentes de fase, comandos de condução e hooks de verificação.',
    destino: '<projeto>/.claude/plugins/orkastery'
  },
  {
    nome: 'hermes',
    entrega: 'Skill roteadora fina, plugin que a declara e script de abertura de thread.',
    destino: '<projeto>/.hermes'
  },
  {
    nome: 'openclaw',
    entrega: 'openclaw.plugin.json com 16 tools ork_*, cada uma uma chamada de CLI.',
    destino: '<projeto>/.openclaw'
  },
  {
    nome: 'codex',
    entrega: 'Skill, MCP com ações do dono e CHECK nativo por codex review.',
    destino: '<projeto>/.codex'
  }
];

const comparativo = [
  {
    solto: 'Três agentes no mesmo repositório editam os mesmos arquivos.',
    fabrica: 'Uma worktree git por thread, e escrita fora dela barrada por lease.'
  },
  {
    solto: 'O agente diz que os testes passam, e você acredita.',
    fabrica: 'O verify reexecuta o comando da claim no HEAD real e anexa a saída.'
  },
  {
    solto: 'O contexto acaba e a sessão nova nasce entupida de colagem.',
    fabrica: 'Gate de tokens mede a janela e o handoff triado passa só o que importa.'
  },
  {
    solto: 'O merge é uma corrida, e o último a chegar sobrescreve.',
    fabrica: 'main-tree é o único gate de merge: uma thread mergeia por vez.'
  },
  {
    solto: 'Deu errado, e ninguém sabe dizer onde nem por quê.',
    fabrica: 'Ledger append-only, prompt com sha256 e POSTMORTEM em nove classes fixas.'
  },
  {
    solto: 'Terminou, e ninguém mede se o caminho foi bom.',
    fabrica: 'Um score humano de 0 a 5 em toda entrega, sem exceção.'
  }
];

const estado = [
  { item: 'Onboarding do projeto por ork onboarding, com pauta e retomada de respostas', situacao: 'funciona' },
  { item: 'Pulse de condução, sensores de sessão e fechamento administrativo separado do score', situacao: 'funciona' },
  { item: 'Telemetria econômica: tempo, tokens, custo de referência, espera, riscos e estimativas do PLAN', situacao: 'funciona' },
  { item: 'Playbooks nativos de Claude Code e Codex, com AGENTS.md gerenciado e claims tipadas', situacao: 'funciona' },
  { item: 'Orquestração nos quatro hosts: Hermes, OpenClaw, Claude Code e Codex, sobre o mesmo núcleo', situacao: 'funciona' },
  { item: 'Docs para usuários: instalação, primeira entrega e operação cotidiana em /docs/', situacao: 'funciona' },
  { item: 'Núcleo ork: threads, 6 fases, modos #Classic, #Maestro, #Auto e #Fast, ledger, worktree, leases, board, escalonador', situacao: 'funciona' },
  { item: 'Claims, baseline, verify no HEAD real, motivos tipados e policies executáveis', situacao: 'funciona' },
  { item: 'Gate de tokens, handoff triado em 3 níveis, ork recall por momento', situacao: 'funciona' },
  { item: 'ork ship serializado, com push provado por ls-remote', situacao: 'funciona' },
  { item: 'MASTER log em contrato congelado, POSTMORTEM tipado e índice derivado do ledger', situacao: 'funciona' },
  { item: 'Retry tipado, fila durável de rate limit, GO-FIX e CHECK-REVERIFY', situacao: 'funciona' },
  { item: '7 packs de auditoria, board de dívida, superfície de ataque de rede (SP8 a SP12)', situacao: 'funciona' },
  { item: 'Adaptadores dos quatro hosts, com skills, MCP e contratos tipados conforme cada cliente', situacao: 'funciona' },
  { item: 'Camada OrkMind (memory.mode: orkmind), com degradação honesta para files', situacao: 'funciona' },
  { item: 'Company Brain B1/B2: schema versionado, ACL, proveniência, receipts, reconciliação e rollback', situacao: 'funciona' },
  { item: 'Biblioteca governada no OrkMind: tipos, coleções e fontes separados; fatos técnicos sob filtro', situacao: 'funciona' },
  { item: 'Captura e consulta do Brain nos quatro hosts: Hermes, OpenClaw, Claude Code e Codex', situacao: 'funciona' },
  { item: 'Criação durável de produto, projeto, iniciativa e operação, com journal e recuperação', situacao: 'funciona' },
  { item: 'Medida runtime_reported de ocupação de janela', situacao: 'não existe' },
  { item: 'Runtimes homologados: Claude Code (claude-bg) e Codex (codex)', situacao: 'funciona' },
  { item: 'Maestro mode autônomo com Objective Envelope', situacao: 'funciona' },
  { item: 'Company Brain B3–B7, cuidadores, Atlas, dados e world model', situacao: 'planejado' }
];

const estagios = [
  {
    nome: 'nascente',
    packs: 'clean-code · reuse',
    desc: 'Só avisa: o builder cria livre e o auditor anota.',
    ativo: false
  },
  {
    nome: 'crescendo',
    packs: '+ architecture · data-model · ux',
    desc: 'Achado crítico vira proposta prioritária no roadmap.',
    ativo: false
  },
  {
    nome: 'maduro',
    packs: '+ security-privacy · process',
    desc: 'A recorrência propõe promover a policy de warn para block.',
    ativo: true
  }
];

const regras = [
  { codigo: 'SP8', texto: 'rota sem guarda de autenticação' },
  { codigo: 'SP9', texto: 'endpoint de administração exposto' },
  { codigo: 'SP10', texto: 'rota sem limite de taxa' },
  { codigo: 'SP11', texto: 'CORS permissivo' },
  { codigo: 'SP12', texto: 'rota sem esquema de validação de payload' }
];

const fixes = [
  {
    rotulo: 'go-fix',
    texto: 'Correção tipo A, de uma linha, recebe reverify <strong>parcial</strong>: só o que foi afetado. Tipo B devolve a tarefa ao GO e exige reverify <strong>completo</strong>. O veredito sai por correção, além do veredito da rodada.'
  },
  {
    rotulo: 'fila durável',
    texto: 'Runtime bateu limite de uso? A fase não morre: entra numa fila durável com o horário de reset lido do próprio stderr do adapter, e é retomada na janela seguinte, sem humano no meio.'
  },
  {
    rotulo: 'freio',
    texto: 'Estourou <code>retry.max_tentativas</code>? Sobe para o humano e para até o #Auto. Autonomia sem freio seria só ausência de controle.'
  }
];
---

<Base
  titulo="Ork · O motor da AI Software Factory"
  descricao="Ork é o CLI determinístico da Orkastery: conduz N loops de agentes por seis fases, quatro modos de condução por #TAG, verificação de claims no HEAD real e score humano de 0 a 5 em toda entrega."
>
  <!-- HERO -->
  <section class="ork-hero">
    <div class="ork-hero-brilho paralaxe" data-paralaxe="18" aria-hidden="true"></div>
    <div class="ork-hero-grade" aria-hidden="true"></div>

    <div class="container">
      <p class="micro-rotulo revela">ork · ai software factory</p>

      <h1 class="display ork-titulo">
        <span class="revela-corte"><span>O motor da fábrica</span></span>
        <span class="revela-corte" style="--atraso: 0.1s"><span>de software <em>autônoma</em></span></span>
      </h1>

      <p class="paragrafo ork-sub revela" style="--atraso: 0.28s">
        Um CLI determinístico que conduz N loops de agentes por seis fases e verifica
        cada alegação no HEAD real. Sem LLM embutido.
      </p>

      <div class="terminal ork-terminal revela" style="--atraso: 0.38s">
        <div class="terminal-topo">
          <span>instalação{!externos.npm.aberto && <span class="selo-em-breve">em breve no npm</span>}</span>
          <button class="copiar" type="button" data-copiar="npm install -g @orkastery/cli">copiar</button>
        </div>
        <pre><span class="cmd">npm install -g @orkastery/cli</span>
<span class="cmd">ork doctor</span>
o que vale nesta máquina agora: node, git,
repositório, runtime adapter, manifesto.
<span class="saida-ok">sai diferente de zero quando está bloqueado.</span></pre>
      </div>

      <div class="ork-acoes revela" style="--atraso: 0.46s">
        <Externo destino="orkastery" class={externos.orkastery.aberto ? 'botao botao-latao' : 'botao botao-fantasma'}>
          Repositório no GitHub
          <svg class="seta" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M2 7h9M7.5 3.5 11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </Externo>
        <Externo destino="npm" class="botao botao-fantasma">Pacote no npm</Externo>
      </div>
    </div>
  </section>

  <!-- CICLO COMPLETO -->
  <section class="secao" aria-labelledby="ork-ciclo-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">o ciclo</p>
        <h2 class="display revela" id="ork-ciclo-titulo" style="--atraso: 0.06s">A looping thread</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Toda demanda vira um ciclo fechado: worktree própria, estado em disco próprio,
          ledger próprio, score próprio. As fases são sempre seis; os modos apenas agrupam
          fases em blocos.
        </p>
      </div>
      <div class="revela" style="--atraso: 0.2s">
        <CicloFases />
      </div>
    </div>
  </section>

  <!-- MODOS -->
  <section class="secao faixa" aria-labelledby="ork-modos-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">condução</p>
        <h2 class="display revela" id="ork-modos-titulo" style="--atraso: 0.06s">Cinco modos, uma #TAG no pedido</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Você escolhe quanta pausa quer escrevendo a #TAG no próprio pedido. O host extrai
          a tag chamando o núcleo, e a validação também é do núcleo. Selecione um modo.
        </p>
      </div>
      <div class="revela" style="--atraso: 0.2s">
        <EspectroModos />
      </div>
    </div>
  </section>

  <!-- VERIFICACAO -->
  <section class="secao" aria-labelledby="ork-verify-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">o coração do produto</p>
        <h2 class="display revela" id="ork-verify-titulo" style="--atraso: 0.06s">A maquinaria que não acredita em self-report</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Este é o produto. O resto é conveniência.
        </p>
      </div>

      <MaquinaVerificacao />

      <div class="fixes">
        {fixes.map((fix, indice) => (
          <div class="painel fix-painel revela" style={`--atraso: ${indice * 0.08}s`}>
            <p class="micro-rotulo">{fix.rotulo}</p>
            <p class="fix-texto" set:html={fix.texto} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THREADS PARALELAS -->
  <section class="secao faixa" aria-labelledby="ork-threads-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">paralelismo sem colisão</p>
        <h2 class="display revela" id="ork-threads-titulo" style="--atraso: 0.06s">N looping threads, sem atropelo</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Rodar várias threads ao mesmo tempo é fácil. Rodar várias threads sem que elas se
          atropelem é o trabalho.
        </p>
      </div>
      <div class="revela" style="--atraso: 0.2s">
        <ThreadsParalelas />
      </div>
    </div>
  </section>

  <!-- GATE DE TOKENS -->
  <section class="secao" aria-labelledby="ork-gate-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">janela de contexto</p>
        <h2 class="display revela" id="ork-gate-titulo" style="--atraso: 0.06s">O gate de tokens e o handoff triado</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          A janela de contexto acaba no meio da thread. Copiar a sessão inteira para a
          próxima entrega uma sessão nova já cheia e sem espaço para trabalhar. O ork tria.
        </p>
      </div>
      <div class="revela" style="--atraso: 0.2s">
        <GateTokens />
      </div>
    </div>
  </section>

  <!-- RADAR HITL -->
  <section class="secao faixa" aria-labelledby="ork-radar-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">condução proativa</p>
        <h2 class="display revela" id="ork-radar-titulo" style="--atraso: 0.06s">O radar HITL</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Detectar pausa, impedimento e espera por humano antes de o humano perguntar.
        </p>
      </div>
      <div class="revela" style="--atraso: 0.2s">
        <RadarHitl />
      </div>
    </div>
  </section>

  <!-- AUDITORES -->
  <section class="secao" aria-labelledby="ork-audit-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">auditoria periódica</p>
        <h2 class="display revela" id="ork-audit-titulo" style="--atraso: 0.06s">Hardening por estágio</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Cobrança de maduro em produto nascente mata a velocidade; leniência de nascente em
          produto maduro mata o produto. Os packs ativos acompanham o estágio.
        </p>
      </div>

      <ol class="estagios">
        {estagios.map((estagio, indice) => (
          <li
            class={`painel estagio revela ${estagio.ativo ? 'painel-latao estagio-ativo' : ''}`}
            style={`--atraso: ${indice * 0.08}s`}
          >
            <span class="estagio-passo mono" aria-hidden="true">{`0${indice + 1}`}</span>
            <p class="estagio-nome display">{estagio.nome}</p>
            <p class="estagio-packs mono">{estagio.packs}</p>
            <p class="estagio-desc">{estagio.desc}</p>
          </li>
        ))}
      </ol>

      <div class="superficie revela">
        <p class="titulo-3">Varredura determinística da superfície de rede, sem LLM</p>
        <ul class="regras escalona">
          {regras.map((regra) => (
            <li class="regra">
              <code class="mono regra-codigo">{regra.codigo}</code>
              <span>{regra.texto}</span>
            </li>
          ))}
        </ul>
        <p class="paragrafo superficie-nota">Quando a leitura não dá confiança, o achado
        sai com confiança baixa e o título diz <strong>requer confirmação humana</strong>.
        Falso positivo disfarçado de certeza é o defeito que esse módulo existe para
        evitar. O auditor também não tem direito a self-report: <code>ork audit
        verify</code> reexecuta as claims dos achados.</p>
      </div>
    </div>
  </section>

  <!-- SCORE -->
  <section class="secao faixa" aria-labelledby="ork-score-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">o fecho</p>
        <h2 class="display revela" id="ork-score-titulo" style="--atraso: 0.06s">Toda thread termina na mesma pergunta</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
      </div>
      <div class="revela" style="--atraso: 0.14s">
        <ScoreDial />
      </div>
    </div>
  </section>

  <!-- ADAPTADORES -->
  <section class="secao" aria-labelledby="ork-adapt-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">adaptadores de host</p>
        <h2 class="display revela" id="ork-adapt-titulo" style="--atraso: 0.06s">Seu host, seus runtimes</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          O ork não quer ser a sua interface. Ele quer ser o motor debaixo dela. Zero regra
          de negócio no host: a #TAG do seu pedido vira modo porque o host pergunta ao
          núcleo, e quem valida é o núcleo.
        </p>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Os adaptadores abaixo conectam seu host ao <code>ork</code>. Para executar a
          sinfonia, os dois runtimes homologados são Claude Code (<code>claude-bg</code>)
          e Codex (<code>codex</code>). Escolha runtime, modelo e esforço por bloco
          com <code>ork setup</code>.
        </p>
      </div>

      <div class="hub">
        {adaptadores.map((adaptador, indice) => (
          <div class="painel host revela" style={`--atraso: ${indice * 0.08}s`}>
            <p class="host-nome mono">{adaptador.nome}</p>
            <p class="host-entrega">{adaptador.entrega}</p>
            <p class="host-destino mono">{adaptador.destino}</p>
          </div>
        ))}
      </div>

      <div class="terminal hub-terminal revela">
        <div class="terminal-topo">
          <span>hosts e runtimes</span>
          <button class="copiar" type="button" data-copiar="ork adapter list">copiar</button>
        </div>
        <pre><span class="cmd">ork adapter list</span>       os hosts e o destino de cada um
<span class="cmd">ork adapter show hermes</span>  os 3 pitfalls de instalação do host
<span class="cmd">ork adapter install claude-code</span>  exemplo para o host Claude Code
<span class="saida-quente">rode com --dry-run antes de instalar o host</span>
<span class="cmd">ork setup</span>  runtimes: Claude Code (claude-bg) e Codex (codex)</pre>
      </div>
    </div>
  </section>

  <!-- COMPARATIVO -->
  <section class="secao faixa" aria-labelledby="ork-comp-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">o contraste</p>
        <h2 class="display revela" id="ork-comp-titulo" style="--atraso: 0.06s">Por que não só um agente solto?</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
      </div>

      <div class="duelo">
        <p class="duelo-cabeca mono revela">um agente solto</p>
        <p class="duelo-cabeca duelo-cabeca-latao mono revela">uma fábrica conduzida</p>
        {comparativo.map((linha, indice) => (
          <div class="duelo-par revela" style={`--atraso: ${indice * 0.05}s`}>
            <div class="duelo-celula">
              <p>{linha.solto}</p>
            </div>
            <div class="duelo-celula duelo-celula-latao">
              <p>{linha.fabrica}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HONESTIDADE -->
  <section class="secao" aria-labelledby="ork-estado-titulo">
    <div class="container">
      <div class="cabeca-secao">
        <p class="micro-rotulo revela">estado real</p>
        <h2 class="display revela" id="ork-estado-titulo" style="--atraso: 0.06s">O que existe hoje, e o que ainda não</h2>
        <div class="regua revela" style="--atraso: 0.1s" aria-hidden="true"></div>
        <p class="paragrafo revela" style="--atraso: 0.14s">
          Este projeto publica lacuna como lacuna. O que está escrito como pronto tem
          comando que prova; o que não está pronto é dito com todas as letras.
        </p>
      </div>

      <ul class="estado-lista">
        {estado.map((linha, indice) => (
          <li
            class={`estado-linha revela ${linha.situacao !== 'funciona' ? 'estado-lacuna' : ''}`}
            style={`--atraso: ${Math.min(indice * 0.035, 0.3)}s`}
          >
            <span class="estado-selo mono">{linha.situacao}</span>
            <span class="estado-item">{linha.item}</span>
          </li>
        ))}
      </ul>

      <p class="paragrafo estado-nota revela">O Orkastery é construído com Orkastery: cada
      pull request do núcleo traz o pacote das claims, e o CI reexecuta cada uma antes do
      merge. O que ainda não funciona está marcado acima como lacuna, com todas as letras.</p>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="secao final">
    <div class="final-aura paralaxe" data-paralaxe="14" aria-hidden="true"></div>
    <div class="container final-conteudo">
      <p class="micro-rotulo revela sem-ponto">a batuta é sua</p>
      <h2 class="display final-titulo revela" style="--atraso: 0.06s">Pronto para reger?</h2>
      <div class="final-acoes revela" style="--atraso: 0.14s">
        <Externo destino="orkastery" class={externos.orkastery.aberto ? 'botao botao-latao' : 'botao botao-fantasma'}>
          Começar pelo repositório
          <svg class="seta" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M2 7h9M7.5 3.5 11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </Externo>
        <a class={externos.orkastery.aberto ? 'botao botao-fantasma' : 'botao botao-latao'} href="/#contato">Falar com a org</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */

  .ork-hero {
    position: relative;
    padding-top: calc(72px + clamp(4.5rem, 11vh, 8rem));
    padding-bottom: var(--secao);
    overflow: hidden;
  }

