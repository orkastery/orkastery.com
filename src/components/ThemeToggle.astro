---
import {localeFor} from '../data/i18n';
const locale=localeFor(Astro.url.pathname);
const label={pt:'Tema claro',en:'Light theme',es:'Tema claro'}[locale];
---
<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" hidden>
 <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
 <span>{label}</span>
</button>
<script>
 const buttons=document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
 const sync=()=>buttons.forEach(button=>button.setAttribute('aria-pressed',String(document.documentElement.dataset.theme==='light')));
 for(const button of buttons){button.hidden=false;button.addEventListener('click',()=>{
  const theme=document.documentElement.dataset.theme==='light'?'dark':'light';
  document.documentElement.dataset.theme=theme;
  try{localStorage.setItem('ork-theme',theme);}catch{}
  sync();
 });}
 sync();
</script>
<style>
.theme-toggle{display:inline-flex;align-items:center;gap:.5rem;min-height:44px;padding:.5rem .75rem;border:1px solid var(--linha-forte);border-radius:var(--raio-campo);background:var(--painel);font-size:.85rem;}
.theme-toggle[hidden]{display:none;}.theme-toggle svg{fill:none;stroke:currentColor;stroke-width:1.5;}
.theme-toggle:hover{border-color:var(--acento);}
.theme-toggle[aria-pressed='true']{border-color:var(--acento);background:var(--latao-fraco);}
</style>
