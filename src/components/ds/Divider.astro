---
// Divisor de seção do design: fio em degradê com um ponto de latão no meio.
// fundo: a cor da faixa e do anel em volta do ponto (papel ou branco).
interface Props { fundo?: 'papel'|'branco'; }
const {fundo='papel'}=Astro.props;
---
<div aria-hidden="true" class:list={['divisor',fundo==='branco'&&'divisor-branco']}><div class="container"><div class="divisor-fio"><span></span></div></div></div>
<style>
.divisor{background:var(--papel)}
.divisor-branco{background:var(--branco)}
.divisor-fio{position:relative;height:1px;background:linear-gradient(to right,rgba(18,22,28,0),var(--linha-divisor) 10%,var(--linha-divisor) 90%,rgba(18,22,28,0))}
.divisor-fio span{position:absolute;left:50%;top:50%;width:7px;height:7px;margin:-3.5px 0 0 -3.5px;border-radius:50%;background:var(--acento);box-shadow:0 0 0 5px var(--papel)}
.divisor-branco .divisor-fio span{box-shadow:0 0 0 5px var(--branco)}
</style>
