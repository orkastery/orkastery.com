---
// Abertura de seção: rótulo, h2 (com a continuação em cinza, se houver) e parágrafo.
// medidaTitulo e medidaLead são as larguras de leitura do HTML da home (em ch).
import TechnicalText from '../TechnicalText.astro';
import Eyebrow from './Eyebrow.astro';
interface Props { sobretitulo: string; titulo: string; continuacao?: string; lead?: string; medidaTitulo?: string; medidaLead?: string; id?: string; }
const {sobretitulo,titulo,continuacao,lead,medidaTitulo='18ch',medidaLead='60ch',id}=Astro.props;
---
<Eyebrow texto={sobretitulo}/>
<h2 class="secao-titulo" data-reveal style={`max-width:${medidaTitulo}`} id={id}>{titulo}{continuacao&&<> <span class="secao-continuacao">{continuacao}</span></>}</h2>
{lead&&<p class="secao-lead" style={`max-width:${medidaLead}`}><TechnicalText text={lead}/></p>}
<style>
.secao-titulo{margin:var(--e-4) 0 0;font:var(--tipo-titulo-1);letter-spacing:var(--trk-titulo-1);text-wrap:balance}
.secao-continuacao{color:var(--texto-3)}
.secao-lead{margin:var(--e-5) 0 0;font:var(--tipo-corpo);color:var(--texto-2);text-wrap:pretty}
</style>
