---
const nodes=Array.from({length:6},(_,i)=>({x:92+i*200,verified:i>=3}));
---
<svg class="factory-tracks" viewBox="0 0 1200 120" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
 <g fill="none" stroke="var(--linha-forte)" stroke-width="1"><path d="M0 30H260L300 60H860L900 90H1200"/><path d="M0 90H260L300 60H860L900 30H1200"/><path d="M0 60H1200"/></g>
 {nodes.map(node=><g><circle cx={node.x} cy="60" r="5" fill="var(--painel)" stroke={node.verified?'var(--prova)':'var(--acento)'} stroke-width="2"/>{node.verified&&<path d={`m${node.x-2} 60 1.5 2 3-4`} fill="none" stroke="var(--prova)"/>}</g>)}
</svg>
<style>
.factory-tracks{position:absolute;inset:2.8rem 0 auto;width:100%;height:7.5rem;pointer-events:none;opacity:.5;mask-image:linear-gradient(to right,transparent,black 8%,black 92%,transparent);}
</style>
