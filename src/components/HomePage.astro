---
// A home do design do dono (Claude Design), na ordem dele: hero, runtimes, 01 a 08, chamada final.
// O rodapé e o cabeçalho vêm do layout (Base). O texto vem de src/data/home.ts, na língua da página.
import Base from '../layouts/Base.astro';
import Divider from './ds/Divider.astro';
import Hero from './home/Hero.astro';
import Runtimes from './home/Runtimes.astro';
import Paralelismo from './home/Paralelismo.astro';
import Problema from './home/Problema.astro';
import ParaQuem from './home/ParaQuem.astro';
import Modos from './home/Modos.astro';
import Atencao from './home/Atencao.astro';
import Noite from './home/Noite.astro';
import Ciclo from './home/Ciclo.astro';
import Prova from './home/Prova.astro';
import ChamadaFinal from './home/ChamadaFinal.astro';
import home from '../data/home';
import {localeFor} from '../data/i18n';
const locale=localeFor(Astro.url.pathname),t=home[locale];
// O navegador recebe só o que recalcula; o resto da página já sai pronta do build.
const runtime={hero:{names:t.hero.names,waitTag:t.hero.waitTag},parallel:t.parallel,attention:{threads:t.attention.threads,states:t.attention.states,options:t.attention.options,noteBefore:t.attention.noteBefore,noteAfter:t.attention.noteAfter},night:{events:t.night.events},modes:{list:t.modes.list,whenLabel:t.modes.whenLabel},cycle:{phases:t.cycle.phases,givesLabel:t.cycle.givesLabel}};
---
<Base titulo={t.title} descricao={t.description}>
 <Hero {t}/>
 <Runtimes {t}/>
 <Divider/>
 <Paralelismo {t}/>
 <Divider/>
 <Problema {t}/>
 <Divider/>
 <ParaQuem {t}/>
 <Divider/>
 <Modos {t}/>
 <Divider/>
 <Atencao {t}/>
 <Noite {t}/>
 <Ciclo {t}/>
 <Divider fundo="branco"/>
 <Prova {t}/>
 <ChamadaFinal titulo={t.cta.title} texto={t.cta.text} falar={t.cta.talk}/>
 <script type="application/json" id="home-dados" set:html={JSON.stringify(runtime).replace(/</g,'\\u003c')}></script>
</Base>
<script>
 import '../scripts/home.ts';
</script>
