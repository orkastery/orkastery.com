---
import TechnicalText from './TechnicalText.astro';
import VerificationReceipt from './VerificationReceipt.astro';
import Base from '../layouts/Base.astro';
import HomeSections from './HomeSections.astro';
import Contato from './Contato.astro';
import DocsDiagram from './DocsDiagram.astro';
import home from '../data/home';
import {localeFor,localize,ui} from '../data/i18n';
import catalog from '../data/docs-catalog';
const locale=localeFor(Astro.url.pathname),text=ui(locale),copy=Astro.props.content||home[locale];
const docsHref=(path:string)=>(Astro.props.docsBase||'')+localize(path,locale);
const legacy={"topo": ["manifesto-titulo"], "metodo": ["ciclo-titulo", "ork-ciclo-titulo", "ork-threads-titulo", "ork-estado-titulo"], "modos": ["modos-titulo", "ork-modos-titulo", "ork-radar-titulo"], "evidencia": ["numeros-titulo", "ork-verify-titulo", "ork-gate-titulo", "ork-audit-titulo", "ork-score-titulo"], "memoria": ["ecossistema-titulo"], "arquitetura": ["camadas-titulo", "ork-adapt-titulo", "ork-comp-titulo"]};
const restored=!Astro.props.content;
const restoredIds=['manifesto-titulo','ciclo-titulo','modos-titulo','numeros-titulo','ecossistema-titulo'];
const aliasesFor=(id:string)=>(legacy[id]||[]).filter(alias=>!restored||!restoredIds.includes(alias));
const diagram=Astro.props.diagram===false?null:'layers';
---
<Base titulo={(Astro.props.product||'Orkastery')+' · '+copy.description} descricao={copy.description}>
 <section class:list={['editorial-hero',{'hero-with-receipt':restored}]} id="topo"><div class:list={['home-container',{'hero-grid':restored}]}>
 <div class="hero-copy">
 <p class="home-kicker">{text.openSource} · {text.license}</p>
 {aliasesFor('topo').map(id=><span {id} aria-hidden="true"/>)}<h1><TechnicalText text={copy.title}/></h1><p class="home-lead"><TechnicalText text={copy.lead}/></p>
 <div class="home-actions"><a class="home-primary" href={docsHref('/docs/comecar/')}>{text.start} →</a><a href={Astro.props.repository||catalog.repository}>GitHub ↗</a></div>
 </div>
 {restored&&<VerificationReceipt {locale}/>}
 </div></section>
 <div class="home-container home-main">
 <div class="home-grid">{copy.sections.map(s=><section class="home-card" id={s.id}>{aliasesFor(s.id).map(id=><span {id} aria-hidden="true"/>)}<h2><TechnicalText text={s.title}/></h2><p><TechnicalText text={s.text}/></p><a href={s.href.startsWith('https:')?s.href:docsHref(s.href)}>{text.read} →</a></section>)}</div>
 <section class="home-mechanism" id="arquitetura"><div>{aliasesFor('arquitetura').map(id=><span {id} aria-hidden="true"/>)}<p class="home-kicker">{text.concepts}</p><h2><TechnicalText text={copy.mechanism}/></h2><p><TechnicalText text={copy.mechanismText}/></p><a href={docsHref('/docs/arquitetura/')}>{text.read} →</a></div>{diagram&&<DocsDiagram name={diagram} {locale}/>}</section>
 <section class="home-install" id="instalar"><div>{aliasesFor('instalar').map(id=><span {id} aria-hidden="true"/>)}<h2><TechnicalText text={copy.install}/></h2><p><TechnicalText text={copy.installText}/></p><a href={docsHref('/docs/comecar/')}>{text.docs} →</a></div><pre tabindex="0"><code>{copy.command}</code></pre></section>
 </div>
 {restored&&<HomeSections/>}
 <Contato/>
</Base>
<style>
.home-container{max-width:1160px;margin:auto;padding-inline:1.5rem;}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:3rem;align-items:center;}
.hero-copy{min-width:0;}
.editorial-hero.hero-with-receipt{padding-block:clamp(3rem,6vw,5rem);}
.hero-with-receipt h1{font-size:clamp(2.5rem,4.1vw,3.65rem);}
.editorial-hero{padding:clamp(4rem,10vw,8rem) 0;background:linear-gradient(var(--grade) 1px,transparent 1px),linear-gradient(90deg,var(--grade) 1px,transparent 1px),radial-gradient(ellipse at 90% 20%,var(--latao-fraco),transparent 60%);background-size:48px 48px,48px 48px,auto;border-bottom:1px solid var(--linha-forte);}
.home-kicker{color:var(--latao,var(--verde));font-size:.94rem;line-height:1.5;margin-bottom:1.5rem;}
h1,h2{font-family:var(--f-display,var(--fonte-display));line-height:1.1;letter-spacing:-.035em;font-weight:600;text-transform:none;}
h1{font-size:clamp(2.8rem,6.5vw,5.4rem);max-width:19ch;}
.home-lead{max-width:57ch;font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.65;color:var(--tinta-2,var(--texto-2));margin-top:2rem;}
.home-actions{display:flex;gap:1.75rem;flex-wrap:wrap;align-items:center;margin-top:2.5rem;}
a{color:var(--latao,var(--verde));text-underline-offset:.25em;}
a:focus-visible{outline:2px solid currentColor;outline-offset:5px;}
.home-primary{padding:.85rem 1.3rem;background:var(--latao,var(--verde));color:var(--sobre-latao,var(--fundo));border-radius:var(--raio-campo);text-decoration:none;font-weight:600;}
.home-main{padding-block:4rem;}
.home-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;}
.home-card{position:relative;box-shadow:var(--sombra-1);padding:2rem;border:1px solid var(--linha-forte);border-radius:var(--raio-superficie);background:var(--painel,var(--fundo-2));}
.home-card::before{content:"";display:block;width:2rem;height:3px;background:var(--acento);margin-bottom:1.5rem;}
.home-card:hover{border-color:var(--acento);}
h2{font-size:clamp(1.6rem,2.8vw,2.5rem);max-width:25ch;}
p{line-height:1.75;margin:1rem 0;color:var(--tinta-2,var(--texto-2));}
.home-mechanism,.home-install{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;margin-top:5rem;}
pre{padding:1.5rem;border:1px solid var(--linha-forte);border-radius:var(--raio-superficie);overflow:auto;max-width:100%;background:var(--painel,var(--fundo-3));font:.9rem/1.8 var(--f-mono,var(--fonte-mono));}
@media(max-width:760px){.home-grid,.home-mechanism,.home-install{grid-template-columns:minmax(0,1fr);}.home-card{padding:1.5rem;}.home-mechanism,.home-install{gap:1rem;margin-top:3rem;}}
@media(max-width:900px){.hero-grid{grid-template-columns:minmax(0,1fr);}.hero-with-receipt h1{font-size:clamp(2.5rem,6.5vw,3.65rem);}}
</style>
