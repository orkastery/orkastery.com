---
import diagrams from '../data/docs-diagrams';
const {name,locale}=Astro.props,d=diagrams[name]?.[locale];
if(!d) throw Error('Missing diagram translation: '+name+'/'+locale);
const prefix='diagram-'+name;
const height=d.nodes.length*112-28;
---
<figure class="docs-diagram" data-docs-diagram>
 <svg viewBox={`0 0 540 ${height}`} role="img" aria-labelledby={`${prefix}-title ${prefix}-desc`}>
 <title id={prefix+'-title'}>{d.title}</title><desc id={prefix+'-desc'}>{d.description}</desc>
 <defs><marker id={prefix+'-arrow'} markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0 0 8 4 0 8" fill="currentColor"/></marker></defs>
 {d.nodes.map((node,i)=><g><rect x="12" y={i*112+4} width="516" height="66" rx="10"/><text x="34" y={i*112+44}>{i+1}.</text><text x="75" y={i*112+(node.includes(' · ')?30:44)}><tspan>{node.split(' · ')[0]}</tspan>{node.includes(' · ')&&<tspan x="75" dy="27" class="node-detail">{node.split(' · ')[1]}</tspan>}</text>{i < d.nodes.length - 1 && <g><path class="connector" d={`M48 ${i*112+72} v32`} marker-end={`url(#${prefix}-arrow)`}/><text class="edge-label" x="75" y={i*112+98}>{d.edges[i]}</text></g>}</g>)}
 </svg>
 <figcaption><strong>{d.title}.</strong> {d.description}</figcaption>
</figure>
<style>
/* Diagrama das docs na Partitura: cartão em papel, nós em névoa clara, texto em Hanken e mono. */
.docs-diagram{margin:var(--e-6) 0;padding:var(--e-5);background:var(--superficie);border:1px solid var(--linha);border-radius:var(--raio-cartao)}
svg{width:100%;max-width:540px;display:block;margin:auto;color:var(--texto)}
rect{fill:color-mix(in srgb,var(--superficie-2) 60%,var(--superficie));stroke:color-mix(in srgb,var(--texto) 18%,transparent);stroke-width:1.2}
text{fill:currentColor;font:500 23px var(--f-texto)}
.node-detail{fill:var(--texto-3);font:400 19px var(--f-mono)}
.edge-label{fill:var(--texto-3);font:400 19px var(--f-mono)}
.connector{fill:none;stroke:color-mix(in srgb,var(--texto-3) 60%,var(--linha));stroke-width:1.5}
figcaption{margin-top:var(--e-3);font:var(--tipo-apoio);color:var(--texto-3)}
figcaption strong{color:var(--texto);font-weight:var(--peso-destaque)}
@media(max-width:550px){.docs-diagram{padding:var(--e-3)}}
</style>
