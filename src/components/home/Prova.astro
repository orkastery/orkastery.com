---
// 08 · Prova (#prova): os quatro números com o comando que prova cada um, o terminal do ork demo e
// a lacuna publicada como lacuna. Números e lacuna seguem o README do núcleo (D13). Kit: o
// terminal é bloco de código, sempre noite; a lacuna tem contorno tracejado.
import SectionHead from '../ds/SectionHead.astro';
import TechnicalText from '../TechnicalText.astro';
const {t}=Astro.props;
const p=t.proof;
---
<section id="prova" class="prova secao-padrao">
 <div class="container">
  <span id="evidencia" class="ancora-antiga" aria-hidden="true"></span><span id="numeros-titulo" class="ancora-antiga" aria-hidden="true"></span><span id="ork-verify-titulo" class="ancora-antiga" aria-hidden="true"></span><span id="ork-gate-titulo" class="ancora-antiga" aria-hidden="true"></span><span id="ork-audit-titulo" class="ancora-antiga" aria-hidden="true"></span><span id="ork-score-titulo" class="ancora-antiga" aria-hidden="true"></span>
  <SectionHead sobretitulo={p.eyebrow} titulo={p.title} lead={p.lead} medidaTitulo="18ch" medidaLead="60ch"/>
  <div class="prova-grade" data-reveal>
   <div class="numeros">
    {p.proofs.map(n=><div class="numero holofote" data-holofote>
     <div class="numero-n">{n.n}</div>
     <div class="numero-l">{n.l}</div>
     <code class="numero-c">$ {n.c}</code>
    </div>)}
   </div>
   <div class="terminal" role="figure" aria-label="ork demo" data-tema="noite">
    <div class="terminal-topo"><code class="codigo-liso">ork demo</code><span>{p.demoMeta}</span></div>
    {p.demo.map(d=><div class="terminal-linha"><span style={`color:var(--${d.kc})`}>{d.k}</span><span style={`color:var(--${d.vc})`}>{d.code?<code class="codigo-liso">{d.v}</code>:<TechnicalText text={d.v}/>}</span></div>)}
   </div>
  </div>
  <div class="lacunas">
   <div class="lacunas-titulo">{p.gapsTitle}</div>
   {p.gaps.map(g=><div class="lacuna"><span class="lacuna-s" style={`color:var(--${g.c})`}>{g.s}</span><br/><TechnicalText text={g.t}/></div>)}
  </div>
 </div>
</section>
<style>
.prova{background:var(--superficie)}
.prova-grade{margin-top:var(--e-7);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr));gap:var(--e-5);align-items:stretch}
.numeros{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(262px,100%),1fr));gap:1px;background:var(--linha);border:1px solid var(--linha);border-radius:var(--raio-cartao);overflow:hidden}
.numero{background-color:var(--superficie);padding:var(--e-5);display:flex;flex-direction:column;gap:var(--e-3)}
.numero-n{font:var(--tipo-titulo-1);letter-spacing:var(--trk-titulo-1)}
.numero-l{flex:1;font:var(--tipo-apoio);color:var(--texto-2)}
.numero-c{display:block;font:var(--peso-texto) var(--t-rotulo)/1.4 var(--f-mono);color:var(--verificado-texto);background:none;padding:0;border-radius:0;white-space:nowrap}
/* Duas colunas como no design enquanto o comando cabe inteiro na célula (regra de 03/10); se não
   couber, uma coluna. A 1440 e 1280 a grade é a 2x2 do design. */
.terminal{background:var(--superficie);border-radius:var(--raio-cartao);padding:var(--e-5);font:var(--tipo-codigo);overflow-x:auto}
.terminal-topo{display:flex;align-items:center;justify-content:space-between;gap:var(--e-3);color:var(--texto-2);font-size:var(--t-rotulo);margin-bottom:var(--e-4)}
.terminal-linha{display:grid;grid-template-columns:84px minmax(0,1fr);gap:var(--e-3);white-space:pre-wrap}
/* Identificador dentro do terminal: é código, mas com a letra do próprio terminal, sem chip. */
.terminal-linha :global(code){display:inline;font:inherit;color:inherit;background:none;padding:0;border-radius:0;white-space:nowrap}
.lacunas{margin-top:var(--e-5);padding:var(--e-5);border-radius:var(--raio-cartao);background:var(--superficie-2);border:1px dashed var(--linha-forte);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:var(--e-4) var(--e-6)}
.lacunas-titulo{font:var(--peso-titulo) var(--t-corpo)/1.35 var(--f-titulo)}
.lacuna{font:var(--tipo-apoio);color:var(--texto-2)}
.lacuna-s{font:var(--peso-destaque) var(--t-rotulo)/1 var(--f-mono)}
/* No celular estreito o comando do terminal (inteiro, regra de 03/10) não cabia na coluna e
   rolava: o terminal ganha a borda e a coluna do rótulo mais justas e, abaixo de 340 px, a letra
   um pouco menor, como no comando de instalação. */
@media (max-width:389.98px){
 .terminal{padding:var(--e-4) var(--e-3)}
 .terminal-linha{grid-template-columns:72px minmax(0,1fr);gap:var(--e-2)}
}
@media (max-width:339.98px){.terminal{font-size:12px}}
</style>
