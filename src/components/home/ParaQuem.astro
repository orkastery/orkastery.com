---
// 03 · Para quem (#contato): o cartão claro de quem constrói, com o comando, e o cartão escuro de
// times, com o contato por e-mail (endereço institucional publicado, D7).
import InstallButton from '../ds/InstallButton.astro';
import TechnicalText from '../TechnicalText.astro';
import {contato} from '../../data/i18n';
const {t}=Astro.props;
const a=t.audience;
---
<section id="contato" class="secao-padrao">
 <div class="container">
  <span id="memoria" class="ancora-antiga" aria-hidden="true"></span><span id="ecossistema-titulo" class="ancora-antiga" aria-hidden="true"></span>
  <div class="sobretitulo">{a.eyebrow}</div>
  <div class="publico">
   <div class="publico-cartao holofote" data-holofote>
    <div class="publico-rotulo">{a.builders.label}</div>
    <h2 class="publico-titulo">{a.builders.title}</h2>
    <p class="publico-texto"><TechnicalText text={a.builders.text}/></p>
    <InstallButton variante="cartao"/>
   </div>
   <div class="publico-cartao publico-escuro holofote sobre-escuro" data-holofote>
    <div class="publico-rotulo">{a.teams.label}</div>
    <h2 class="publico-titulo">{a.teams.title}</h2>
    <p class="publico-texto"><TechnicalText text={a.teams.text}/></p>
    <a class="publico-contato" href={'mailto:'+contato}>{a.teams.cta+' →'}</a>
   </div>
  </div>
 </div>
</section>
<style>
.publico{margin-top:28px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:16px}
.publico-cartao{container-type:inline-size;padding:clamp(28px,3.4vw,44px);border-radius:var(--raio-24);background-color:var(--branco);border:1px solid var(--linha-cartao);display:flex;flex-direction:column;gap:18px}
.publico-escuro{background-color:var(--tinta);color:var(--sobre-noite);border:0}
.publico-rotulo{font:500 13px/1 var(--fonte-mono);color:var(--tinta-3)}
.publico-escuro .publico-rotulo{color:var(--sobre-noite-3)}
.publico-titulo{margin:0;font:var(--tipo-titulo-publico);letter-spacing:var(--tracking-titulo-publico);text-wrap:balance}
.publico-texto{margin:0;flex:1;font:var(--tipo-corpo);color:var(--tinta-2);text-wrap:pretty}
.publico-escuro .publico-texto{color:var(--sobre-noite-2)}
.publico-contato{align-self:flex-start;display:flex;align-items:center;gap:10px;height:48px;padding:0 20px;border-radius:var(--raio-12);background:var(--acento);color:var(--sobre-acento);font:600 15px/1 var(--fonte-texto)}
.publico-contato:hover{background:var(--acento-forte);color:var(--sobre-acento)}
/* Abaixo de 360 px o respiro do cartão cede para o comando caber inteiro (regra de 03/10). */
@media (max-width:360px){.publico-cartao{padding:24px 20px}}
</style>
