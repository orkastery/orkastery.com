---
// 05 · Sua atenção (#manha): a janela do ork board que se atualiza sozinha, o resumo das 09:00, a
// pergunta com alternativas a a d e as quatro camadas. Componentes do kit: abaixo de 768 px o board
// vira lista de cartões (D19); na pergunta, a escolhida tem borda --texto e a chave escura, e o
// latão fica só no ponto da recomendada e no que espera você (D18).
import SectionHead from '../ds/SectionHead.astro';
import TechnicalText from '../TechnicalText.astro';
import {board,pulse,options,answerNote,ESTADO_INICIAL,cor} from '../../lib/home-state.mjs';
import {withBase} from '../../data/i18n';
const {t}=Astro.props;
const a=t.attention,linhas=board(t,ESTADO_INICIAL.tick),kpis=pulse(t),opcoes=options(t,ESTADO_INICIAL.answer);
---
<section id="manha" class="secao-padrao">
 <div class="container">
  <SectionHead sobretitulo={a.eyebrow} titulo={a.title} continuacao={a.titleMuted} lead={a.lead} medidaTitulo="20ch" medidaLead="60ch"/>
  <div class="atencao" data-reveal>
   <div class="board">
    <div class="board-topo">
     <div class="board-luzes" aria-hidden="true"><span></span><span></span><span></span></div>
     <span class="board-comando">$ <code class="codigo-liso">ork board</code></span>
     <span class="estica"></span>
     <span class="board-meta">{a.boardMeta}</span>
    </div>
    <div class="board-rolagem">
     <div class="board-tabela" role="table" aria-label="ork board">
      <div class="board-cabeca" role="row">{a.boardHead.map(h=><span role="columnheader">{h}</span>)}</div>
      {linhas.map((l,i)=><div class="board-linha" role="row" data-board={i} style={`background:${cor(l.rowBg)}`}>
       <div class="board-thread" role="cell"><div class="board-nome">{l.name}</div><div class="board-repo">{l.repo}</div></div>
       <div class="board-onde" role="cell">{l.where}</div>
       <div role="cell">
        <div class="board-segmentos">{l.segs.map(s=><span style={`background:${cor(s)}`}></span>)}</div>
        <div class="board-fase" data-board-fase>{l.phase}</div>
       </div>
       <div class="board-estado" role="cell" data-board-estado style={`color:${cor(l.fg)}`}><span style={`background:${cor(l.dot)}`}></span><span data-board-rotulo>{l.label}</span></div>
      </div>)}
     </div>
    </div>
   </div>
   <div class="pulso holofote" data-holofote>
    <div class="pulso-topo">
     <img src={withBase('/marca/svg/simbolo-fundo-claro.svg')} alt="" width="28" height="28"/>
     <div><div class="pulso-nome">ork</div><div class="pulso-quando">{a.pulseWhen}</div></div>
    </div>
    <div class="pulso-numeros">{kpis.map(k=><div style={`background:${cor(k.bg)}`}><div class="pulso-n" style={`color:${cor(k.fg)}`}>{k.n}</div><div class="pulso-l">{k.l}</div></div>)}</div>
    <div class="pulso-pergunta">{a.pulseAsk}</div>
    <div class="pulso-botoes"><span class="pulso-sim">{a.pulseYes}</span><span class="pulso-depois">{a.pulseLater}</span></div>
   </div>
   <div class="pergunta holofote" data-holofote>
    <div class="pergunta-meta"><span>{a.questionMeta}</span><span>{a.questionKeys}</span></div>
    <div class="pergunta-titulo">{a.question}</div>
    <div class="pergunta-opcoes">
     {opcoes.map((o,i)=><button type="button" class="opcao" data-opcao={i} aria-pressed="false" aria-controls="pergunta-nota" style={`background:${cor(o.bg)};border-color:${cor(o.bd)}`}>
      <span class="opcao-chave" style={`background:${cor(o.kbg)};color:${cor(o.kfg)}`}>{o.k}</span>
      <span class="opcao-texto">{o.t}</span>
      {o.rec&&<span class="opcao-rec"><span class="opcao-rec-ponto" aria-hidden="true"></span>{a.recommended}</span>}
     </button>)}
    </div>
    <div class="pergunta-nota" id="pergunta-nota" aria-live="polite">
     <span data-nota="-1"><TechnicalText text={answerNote(t,null)}/></span>
     {a.options.map((_,i)=><span data-nota={i} hidden><TechnicalText text={answerNote(t,i)}/></span>)}
    </div>
   </div>
  </div>
  <div class="camadas" data-reveal>
   {a.layers.map(l=><div><div class="camada-n">{l.n}</div><div class="camada-t">{l.t}</div><p class="camada-d"><TechnicalText text={l.d}/></p></div>)}
  </div>
 </div>
</section>
<style>
.atencao{margin-top:var(--e-7);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr));gap:var(--e-5);align-items:start}
.board{grid-column:1/-1;background:var(--superficie);border:1px solid var(--linha);border-radius:var(--raio-cartao);overflow:hidden;box-shadow:var(--sombra-1)}
.board-topo{display:flex;align-items:center;gap:var(--e-3);padding:var(--e-3) var(--e-5);border-bottom:1px solid var(--linha)}
.board-luzes{display:flex;gap:6px}
.board-luzes span{width:10px;height:10px;border-radius:50%;background:var(--linha)}
.board-comando{font:var(--peso-destaque) var(--t-rotulo)/1 var(--f-mono);color:var(--texto-2);white-space:nowrap}
.estica{flex:1}
.board-meta{font:var(--peso-texto) var(--t-rotulo)/1.3 var(--f-mono);color:var(--texto-3);text-align:right}
.board-rolagem{overflow-x:auto}
.board-tabela{min-width:680px}
.board-cabeca{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1.1fr) 150px 120px;gap:var(--e-4);padding:var(--e-3) var(--e-5);font:var(--tipo-rotulo);line-height:1;letter-spacing:var(--espaco-rotulo);text-transform:uppercase;color:var(--texto-3);border-bottom:1px solid var(--texto)}
.board-linha{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1.1fr) 150px 120px;gap:var(--e-4);align-items:center;padding:var(--e-3) var(--e-5);border-top:1px solid var(--linha);transition:background var(--dur-longa) var(--curva)}
.board-thread{min-width:0}
.board-cabeca+.board-linha{border-top:0}
.board-nome{font:var(--peso-destaque) var(--t-apoio)/1.3 var(--f-texto);color:var(--texto);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.board-repo{margin-top:3px;font:var(--peso-texto) var(--t-rotulo)/1.3 var(--f-mono);color:var(--texto-3)}
.board-onde{font:var(--peso-texto) var(--t-rotulo)/1.4 var(--f-mono);color:var(--texto-2)}
.board-segmentos{display:grid;grid-template-columns:repeat(6,1fr);gap:3px}
.board-segmentos span{height:6px;border-radius:var(--raio-segmento);transition:background var(--dur-longa) var(--curva)}
.board-fase{margin-top:6px;font:var(--peso-destaque) var(--t-rotulo)/1 var(--f-mono);letter-spacing:var(--espaco-rotulo);color:var(--texto-3)}
.board-estado{display:flex;align-items:center;gap:7px;font:var(--peso-destaque) var(--t-rotulo)/1 var(--f-mono)}
.board-estado>span:first-child{width:7px;height:7px;border-radius:50%}
.pulso,.pergunta{background-color:var(--superficie);border:1px solid var(--linha);border-radius:var(--raio-cartao);padding:var(--e-5)}
.pulso-topo{display:flex;align-items:center;gap:var(--e-3)}
.pulso-topo img{width:28px;height:28px}
.pulso-nome{font:var(--peso-titulo) var(--t-apoio)/1.2 var(--f-titulo)}
.pulso-quando{font:var(--peso-texto) var(--t-rotulo)/1.2 var(--f-mono);color:var(--texto-3)}
.pulso-numeros{margin-top:var(--e-5);display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--e-2)}
.pulso-numeros>div{min-width:0;padding:var(--e-3);border-radius:var(--raio-botao)}
.pulso-n{font:var(--tipo-titulo-1);letter-spacing:var(--trk-titulo-1);line-height:1}
.pulso-l{margin-top:var(--e-2);font:var(--peso-destaque) var(--t-rotulo)/1.25 var(--f-texto);color:var(--texto-2)}
.pulso-pergunta{margin-top:var(--e-5);font:var(--tipo-destaque)}
.pulso-botoes{margin-top:var(--e-3);display:flex;gap:var(--e-2);flex-wrap:wrap}
.pulso-sim{display:inline-flex;align-items:center;min-height:var(--alvo);padding:0 var(--e-4);border-radius:var(--raio-botao);background:var(--acao);color:var(--sobre-acao);font:var(--tipo-botao);box-sizing:border-box}
.pulso-depois{display:inline-flex;align-items:center;min-height:var(--alvo);padding:0 var(--e-4);border-radius:var(--raio-botao);color:var(--texto);font:var(--tipo-botao);box-sizing:border-box}
.pergunta-meta{display:flex;align-items:center;justify-content:space-between;gap:var(--e-3);font:var(--peso-destaque) var(--t-rotulo)/1 var(--f-mono);color:var(--texto-3)}
.pergunta-titulo{margin-top:var(--e-3);font:var(--tipo-titulo-3);letter-spacing:var(--trk-titulo-3)}
.pergunta-opcoes{margin-top:var(--e-4);display:flex;flex-direction:column;gap:var(--e-2)}
.opcao{display:flex;align-items:center;gap:var(--e-3);width:100%;min-height:var(--alvo);text-align:left;padding:var(--e-3);border-radius:var(--raio-botao);cursor:pointer;border:1px solid;transition:background var(--dur-curta) var(--curva),border-color var(--dur-curta) var(--curva)}
.opcao:hover{border-color:var(--linha-forte)!important}
.opcao[aria-pressed='true']{box-shadow:inset 0 0 0 .5px var(--texto)}
.opcao[aria-pressed='true']:hover{border-color:var(--texto)!important}
.opcao:focus-visible{box-shadow:var(--anel-foco)}
.opcao-chave{flex:none;width:26px;height:26px;border-radius:var(--raio-chip);display:grid;place-items:center;font:var(--peso-destaque) var(--t-rotulo)/1 var(--f-mono);box-shadow:inset 0 0 0 1px var(--linha)}
.opcao-texto{flex:1;font:var(--peso-destaque) var(--t-apoio)/1.4 var(--f-texto);color:var(--texto)}
.opcao-rec{flex:none;display:inline-flex;align-items:center;gap:6px;font:var(--peso-destaque) var(--t-rotulo)/1 var(--f-mono);color:var(--espera-texto)}
.opcao-rec-ponto{width:7px;height:7px;border-radius:50%;background:var(--espera)}
.pergunta-nota{margin-top:var(--e-3);font:var(--tipo-apoio);color:var(--texto-3)}
.camadas{margin-top:var(--e-7);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:var(--e-6);border-top:1px solid var(--linha-forte);padding-top:var(--e-6)}
.camada-n{font:var(--peso-destaque) var(--t-rotulo)/1 var(--f-mono);color:var(--texto-3)}
.camada-t{margin-top:var(--e-3);font:var(--tipo-titulo-3);letter-spacing:var(--trk-titulo-3)}
.camada-d{margin:var(--e-2) 0 0;font:var(--tipo-apoio);color:var(--texto-2);text-wrap:pretty}
/* Resumo das 09:00: os quatro números em 2 x 2 quando a legenda não cabe em quatro colunas, pela
   largura do próprio cartão (a 768 e a 1280 ele é estreito mesmo com a tela larga). */
.pulso{container-type:inline-size}
@container (max-width:360px){.pulso-numeros{grid-template-columns:repeat(2,minmax(0,1fr))}}
/* No celular a pílula "recomendada" desce para a linha de baixo, alinhada ao texto da alternativa,
   em vez de espremer o texto numa coluna estreita; "a–d" nunca parte no meio. */
@media (max-width:479.98px){
 .pergunta-meta>span:last-child{flex:none}
 .opcao{flex-wrap:wrap;row-gap:var(--e-1)}
 .opcao-texto{flex:1 1 0;min-width:0}
 .opcao-rec{order:3;flex-basis:100%;padding-left:calc(26px + var(--e-3))}
}
/* Abaixo de 768 px o board vira lista de cartões (kit, Responsividade): nome e estado em cima,
   onde roda e a barra de fases embaixo; sem cabeçalho de tabela e sem rolagem lateral. */
@media (max-width:767.98px){
 .board-rolagem{overflow:visible}
 .board-tabela{min-width:0;display:flex;flex-direction:column;gap:var(--e-2);padding:var(--e-3)}
 .board-cabeca{display:none}
 .board-linha{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:'thread estado' 'onde onde' 'fases fases';gap:var(--e-2) var(--e-3);padding:var(--e-3);border:1px solid var(--linha);border-radius:var(--raio-botao)}
 .board-thread{grid-area:thread}
 .board-onde{grid-area:onde}
 .board-linha>[role='cell']:nth-child(3){grid-area:fases}
 .board-estado{grid-area:estado}
}
</style>
