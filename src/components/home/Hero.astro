---
// Hero do design: grade de pontos, selo, título com a continuação em cinza, parágrafo, botão que
// copia o comando, contato, nota e o cartão da partitura (canvas animado com a contagem viva).
import InstallButton from '../ds/InstallButton.astro';
import TechnicalText from '../TechnicalText.astro';
import {versao} from '../../data/release.mjs';
import {preencher} from '../../lib/home-state.mjs';
import {DENSIDADE} from '../../lib/partitura.mjs';
const {t}=Astro.props;
const [fabrica,,licenca]=t.hero.badge;
---
<section id="topo" class="hero">
 <div class="hero-pontos" aria-hidden="true"></div>
 <div class="container hero-conteudo">
  <span id="manifesto-titulo" class="ancora-antiga" aria-hidden="true"></span>
  <div class="hero-selo"><span class="hero-pulso" aria-hidden="true"></span><span>{fabrica}</span><span class="hero-barra" aria-hidden="true">/</span><span><code class="codigo-liso">@orkastery/cli</code> <code class="codigo-liso">{versao}</code></span><span class="hero-barra" aria-hidden="true">/</span><span>{licenca}</span></div>
  <h1 class="hero-titulo">{t.hero.title} <span class="hero-continuacao">{t.hero.titleMuted}</span></h1>
  <p class="hero-lead"><TechnicalText text={t.hero.lead}/></p>
  <div id="instalar" class="hero-acoes">
   <InstallButton variante="hero"/>
   <a class="hero-falar" href="#contato">{t.hero.talk} <span class="hero-seta" aria-hidden="true">→</span></a>
  </div>
  <p class="hero-nota"><TechnicalText text={t.hero.note}/></p>
  <div class="hero-partitura">
   <div class="hero-partitura-topo">
    <div class="hero-partitura-titulo">{preencher(t.hero.scoreHead,{n:DENSIDADE})}</div>
    <div class="hero-vivo" aria-live="off">
     <span><span class="hero-ponto" aria-hidden="true"></span><span data-vivo="run">0</span> {t.hero.live.run}</span>
     <span><span class="hero-ponto hero-ponto-espera" aria-hidden="true"></span><span data-vivo="wait">0</span> {t.hero.live.wait}</span>
     <span><span class="hero-ponto hero-ponto-ok" aria-hidden="true"></span><span data-vivo="ok">0</span> {t.hero.live.ok}</span>
    </div>
   </div>
   <div class="hero-canvas-caixa"><canvas data-partitura role="img" aria-label={t.hero.canvasLabel}></canvas></div>
  </div>
 </div>
</section>
<style>
.hero{position:relative;padding:clamp(64px,10vw,120px) 0 72px}
.hero-pontos{position:absolute;left:0;right:0;top:0;height:760px;background-image:radial-gradient(rgba(18,22,28,.10) 1px,transparent 1.3px);background-size:24px 24px;-webkit-mask-image:radial-gradient(70% 62% at 28% 18%,#000 15%,transparent 72%);mask-image:radial-gradient(70% 62% at 28% 18%,#000 15%,transparent 72%);pointer-events:none}
.hero-conteudo{position:relative}
.hero-selo{display:inline-flex;align-items:center;gap:10px;padding:7px 12px 7px 10px;border-radius:var(--raio-pilula);background:var(--branco);border:1px solid var(--linha-media);font:var(--tipo-selo);color:var(--tinta-2)}
.hero-pulso{width:7px;height:7px;border-radius:50%;background:var(--ok);animation:orkPulse 2.8s ease-in-out infinite}
.hero-barra{color:var(--tinta-7)}
.hero-titulo{margin:28px 0 0;font:var(--tipo-h1);letter-spacing:var(--tracking-h1);max-width:16ch;text-wrap:balance}
.hero-continuacao{color:var(--tinta-4)}
.hero-lead{margin:30px 0 0;max-width:58ch;font:var(--tipo-lead-hero);color:var(--tinta-2);text-wrap:pretty}
.hero-acoes{margin-top:36px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.hero-falar{display:flex;align-items:center;gap:8px;height:52px;padding:0 20px;border-radius:var(--raio-12);background:var(--branco);border:1px solid var(--linha-forte);font:500 15px/1 var(--fonte-texto);color:var(--tinta)}
.hero-falar:hover{border-color:var(--linha-hover);color:var(--tinta)}
.hero-seta{color:var(--acento-texto)}
.hero-nota{margin:16px 0 0;font:var(--tipo-nota);color:var(--tinta-3)}
.hero-partitura{margin-top:64px;background:var(--branco);border:1px solid var(--linha-cartao);border-radius:var(--raio-22);box-shadow:var(--sombra-cartao);overflow:hidden}
.hero-partitura-topo{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;justify-content:space-between;padding:16px 22px;border-bottom:1px solid var(--linha-suave)}
.hero-partitura-titulo{font:500 13px/1 var(--fonte-mono);color:var(--tinta-2)}
.hero-vivo{display:flex;gap:18px;font:500 12.5px/1 var(--fonte-texto);color:var(--tinta-2);flex-wrap:wrap}
.hero-vivo>span{display:flex;align-items:center;gap:7px}
.hero-ponto{width:8px;height:8px;border-radius:50%;background:var(--tinta)}
.hero-ponto-espera{background:var(--acento);box-shadow:0 0 0 3px var(--acento-suave)}
.hero-ponto-ok{background:var(--ok)}
.hero-canvas-caixa{padding:18px 22px 22px}
.hero-canvas-caixa canvas{display:block;width:100%;height:clamp(340px,36vw,440px)}
</style>
