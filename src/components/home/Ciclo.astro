---
// 07 · Como funciona (#ciclo): as seis fases como abas (CHECK no início, como no design), os dois
// cartões da fase escolhida e a nota do GO-FIX. Cada fase sai pronta do build; só a escolhida
// aparece. A aba escolhida usa a cor de ação do kit (--acao), não o latão.
import SectionHead from '../ds/SectionHead.astro';
import TechnicalText from '../TechnicalText.astro';
import {phases,phaseDetail,ESTADO_INICIAL,PH,cor} from '../../lib/home-state.mjs';
const {t}=Astro.props;
const c=t.cycle,abas=phases(t,ESTADO_INICIAL.phase);
---
<section id="ciclo" class="ciclo secao-padrao">
 <div class="container">
  <span id="metodo" class="ancora-antiga" aria-hidden="true"></span><span id="ciclo-titulo" class="ancora-antiga" aria-hidden="true"></span><span id="ork-ciclo-titulo" class="ancora-antiga" aria-hidden="true"></span><span id="ork-threads-titulo" class="ancora-antiga" aria-hidden="true"></span><span id="ork-estado-titulo" class="ancora-antiga" aria-hidden="true"></span>
  <SectionHead sobretitulo={c.eyebrow} titulo={c.title} lead={c.lead} medidaTitulo="18ch" medidaLead="60ch"/>
  <div class="fases" data-reveal data-ciclo role="tablist" aria-label={c.title}>
   {abas.map((f,i)=><button type="button" class="fase" role="tab" id={'fase-'+i} data-fase={i} aria-selected={f.on?'true':'false'} aria-controls="ciclo-painel" tabindex={f.on?'0':'-1'} style={`background:${cor(f.bg)};border-color:${cor(f.bd)};color:${cor(f.fg)}`}>
    <span class="fase-n">{f.n}</span>
    <span class="fase-nome">{f.name}</span>
   </button>)}
  </div>
  <div class="ciclo-detalhe" id="ciclo-painel" role="tabpanel" aria-labelledby={'fase-'+ESTADO_INICIAL.phase} aria-live="polite">
   {PH.map((_,i)=>{const d=phaseDetail(t,i);return <div class="ciclo-par" data-detalhe={i} hidden={i!==ESTADO_INICIAL.phase}>
    <div class="ciclo-cartao">
     <div class="ciclo-rotulo">{d.gives}</div>
     <div class="ciclo-texto"><TechnicalText text={d.givesText}/></div>
    </div>
    <div class="ciclo-cartao ciclo-exige">
     <div class="ciclo-rotulo">{c.needsLabel}</div>
     <div class="ciclo-texto"><TechnicalText text={d.needs}/></div>
     <div class="ciclo-codigo">{d.code.split(' · ').map((c,k)=><>{k>0&&' · '}<code class="codigo-liso">{c}</code></>)}</div>
    </div>
   </div>;})}
  </div>
  <div class="ciclo-nota"><span class="ciclo-chip">{c.failChip}</span><span><TechnicalText text={c.failNote}/></span></div>
 </div>
</section>
<style>
.ciclo{background:var(--superficie);border-top:1px solid var(--linha);border-bottom:1px solid var(--linha)}
.fases{margin-top:var(--e-7);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(150px,100%),1fr));gap:var(--e-2)}
.fase{text-align:left;padding:var(--e-4) var(--e-4) var(--e-5);border-radius:var(--raio-cartao);cursor:pointer;border:1px solid;transition:background var(--dur-media) var(--curva),color var(--dur-media) var(--curva)}
.fase:hover{border-color:var(--linha-forte)!important}
.fase-n{display:block;font:var(--peso-destaque) var(--t-rotulo)/1 var(--f-mono);opacity:.7}
.fase-nome{display:block;margin-top:var(--e-5);font:var(--tipo-titulo-3);letter-spacing:var(--trk-titulo-3);line-height:1}
.ciclo-detalhe{margin-top:var(--e-3)}
.ciclo-par{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:var(--e-3)}
.ciclo-par[hidden]{display:none}
.ciclo-cartao{padding:var(--e-5);border-radius:var(--raio-cartao);background:var(--superficie-2)}
.ciclo-exige{background:color-mix(in srgb,var(--verificado) 6%,var(--superficie));border:1px solid color-mix(in srgb,var(--verificado) 18%,var(--superficie))}
.ciclo-rotulo{font:var(--tipo-rotulo);line-height:1;letter-spacing:var(--espaco-rotulo);text-transform:uppercase;color:var(--texto-3)}
.ciclo-exige .ciclo-rotulo{color:var(--verificado-texto)}
.ciclo-texto{margin-top:var(--e-3);font:var(--peso-destaque) var(--t-titulo-2)/1.35 var(--f-titulo);letter-spacing:var(--trk-titulo-2);text-wrap:pretty}
.ciclo-codigo{margin-top:var(--e-4);font:var(--peso-destaque) var(--t-rotulo)/1.4 var(--f-mono);color:var(--verificado-texto)}
.ciclo-nota{margin-top:var(--e-5);display:flex;align-items:center;gap:var(--e-3);font:var(--tipo-apoio);color:var(--texto-2)}
.ciclo-chip{flex:none;display:inline-flex;align-items:center;height:28px;padding:0 var(--e-3);border-radius:var(--raio-chip);font:var(--peso-destaque) var(--t-rotulo)/1 var(--f-mono);background:color-mix(in srgb,var(--falha) 16%,var(--superficie));color:var(--falha-texto);box-sizing:border-box}
</style>
