---
// Seletor de língua em pílula, como o PT/EN do design, com as três línguas do site.
import {locales,languageName,languageTag,localeFor,localize,moldura,ui} from '../data/i18n';
const locale=localeFor(Astro.url.pathname),text=ui(locale),m=moldura(locale);
---
<nav class="linguas" aria-label={text.language} data-language-selector>
 {locales.map(l=><a href={localize(Astro.url.pathname,l)} hreflang={languageTag[l]} lang={languageTag[l]} aria-current={l===locale?'page':undefined} title={languageName[l]}><span aria-hidden="true">{m.languageShort[l]}</span><span class="so-leitor">{languageName[l]}</span></a>)}
</nav>
<style>
.linguas{display:flex;align-items:center;gap:4px;padding:3px;border-radius:var(--raio-8);background:rgba(18,22,28,.05);font:500 12px/1 var(--fonte-mono);flex:none}
.linguas a{padding:5px 8px;border-radius:var(--raio-6);color:var(--tinta-3)}
.linguas a[aria-current]{background:var(--branco);box-shadow:var(--sombra-pilula);color:var(--tinta)}
.linguas a:hover{color:var(--acento-texto)}
</style>
