---
import copy from '../data/home-sections';
import {localeFor,localize} from '../data/i18n';
import CicloFases from './CicloFases.astro';
import ModosConducao from './ModosConducao.astro';
import MaquinaVerificacao from './MaquinaVerificacao.astro';
import ThreadsParalelas from './ThreadsParalelas.astro';
import GateTokens from './GateTokens.astro';
import RadarHitl from './RadarHitl.astro';
import ScoreDial from './ScoreDial.astro';
const locale=localeFor(Astro.url.pathname), t=copy[locale];
---
<section class="secao secao-manifesto" aria-labelledby="manifesto-titulo" data-home-section="manifesto">
 <div class="container"><h2 class="display manifesto-titulo" id="manifesto-titulo">{t.manifesto.map(line=><span>{line}</span>)}</h2>
 <div class="manifesto-colunas">{t.intro.map(p=><p class="paragrafo">{p}</p>)}</div>
 <ul class="principios">{t.principles.map(p=><li class="painel"><h3>{p}</h3></li>)}</ul></div>
</section>
<section class="secao" aria-labelledby="ciclo-titulo" data-home-section="cycle"><div class="container">
 <div class="cabeca-secao"><h2 class="display" id="ciclo-titulo">{t.cycle}</h2><p class="paragrafo">{t.cycleText}</p></div><CicloFases />
 <details><summary>{t.parallel}</summary><ThreadsParalelas /></details>
</div></section>
<section class="secao" aria-labelledby="modos-titulo" data-home-section="modes"><div class="container">
 <div class="cabeca-secao"><h2 class="display" id="modos-titulo">{t.modes}</h2><p class="paragrafo">{t.modesText}</p></div><ModosConducao />
 <details><summary>{t.radar}</summary><RadarHitl /></details>
</div></section>
<section class="secao secao-verificacao" aria-labelledby="numeros-titulo" data-home-section="verification"><div class="container">
 <div class="cabeca-secao"><h2 class="display" id="numeros-titulo">{t.verify}</h2><p class="paragrafo">{t.verifyText}</p></div>
 <pre tabindex="0"><code>ork verify &lt;thread&gt;
npm --prefix core run test:ci
ork modos</code></pre><MaquinaVerificacao />
 <details><summary>{t.context}</summary><GateTokens /></details><details><summary>{t.score}</summary><ScoreDial /></details>
</div></section>
<section class="secao" aria-labelledby="ecossistema-titulo" data-home-section="ecosystem"><div class="container">
 <div class="cabeca-secao"><h2 class="display" id="ecossistema-titulo">{t.ecosystem}</h2></div>
 <div class="bento"><a class="painel painel-latao cartao-link" href={localize('/ork/',locale)}><h3>Ork · AI Software Factory</h3><p>{t.ork}</p><code>@orkastery/cli 0.5.0</code></a><a class="painel cartao-link" href={'https://orkmind.com'+localize('/',locale)}><h3>OrkMind</h3><p>{t.mind}</p></a></div>
</div></section>
<style>
.manifesto-titulo{max-width:100%;font-size:clamp(1.6rem,3.6vw,2.8rem);line-height:1.14;}
.manifesto-titulo>span{display:block;}.manifesto-titulo>span:nth-child(2){padding-left:clamp(0rem,6vw,4rem);}.manifesto-titulo>span:nth-child(3){padding-left:clamp(0rem,12vw,8rem);color:var(--latao-claro);}
.manifesto-colunas,.bento{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1.5rem,4vw,3.5rem);margin-top:3rem;}
.principios{list-style:none;padding:0;margin-top:3rem;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;}.principios h3{font-size:1.1rem;}.bento h3{font-size:1.5rem;margin-bottom:1rem;}.bento p{margin-bottom:1.5rem;color:var(--tinta-2);}
.secao-verificacao{background:var(--palco);border-block:1px solid var(--linha);}
pre{padding:1.4rem;border:1px solid var(--linha-forte);border-radius:var(--raio-painel);overflow:auto;margin-bottom:3rem;font:.9rem/1.8 var(--f-mono);}
details{margin-top:3rem;border-top:1px solid var(--linha-forte);padding-top:1.4rem;}summary{cursor:pointer;color:var(--latao);font-size:1.1rem;margin-bottom:1.5rem;}summary:focus-visible{outline:2px solid currentColor;outline-offset:4px;}
@media(max-width:760px){.manifesto-colunas,.bento{grid-template-columns:minmax(0,1fr);}.principios{grid-template-columns:repeat(2,minmax(0,1fr));}.principios .painel{padding:1rem;}}
</style>
