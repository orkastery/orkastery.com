---
// Seis compassos, um por fase. As notas sao claims, a patina marca a prova.
const compassos = Array.from({ length: 6 }, (_, fase) => ({
  x: fase * 200,
  notas: [0, 1, 2].map((nota) => ({
    x: 54 + nota * 46,
    y: 38 + ((fase + nota * 2) % 5) * 9,
    comprovada: fase >= 3 && nota === 2,
  })),
}));
---

<svg class="partitura" viewBox="0 0 1200 120" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <g fill="none" stroke="var(--linha)" stroke-width="1">
    {[38, 47, 56, 65, 74].map((y) => <path d={`M0 ${y}H1200`} />)}
    {compassos.map(({ x }) => <path d={`M${x + 12} 38V74`} />)}
    <path d="M1192 38V74M1197 38V74" />
  </g>
  {compassos.map((compasso) => (
    <g transform={`translate(${compasso.x} 0)`}>
      {compasso.notas.map((nota) => (
        <g class="nota" style={`color: var(${nota.comprovada ? '--patina' : '--latao'})`}>
          <ellipse cx={nota.x} cy={nota.y} rx="5" ry="3.2" transform={`rotate(-22 ${nota.x} ${nota.y})`} fill="currentColor" />
          <path d={`M${nota.x + 4} ${nota.y}v-24`} fill="none" stroke="currentColor" stroke-width="1.2" />
        </g>
      ))}
    </g>
  ))}
</svg>

<style>
  .partitura {
    position: absolute;
    inset: 2.8rem 0 auto;
    width: 100%;
    height: 7.5rem;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent, var(--poco) 8%, var(--poco) 92%, transparent);
  }

  .nota { opacity: 0.2; }
</style>
