---
import {localeFor, localize} from '../data/i18n';
const locale=localeFor(Astro.url.pathname);
const translations={
  "t0": {
    "pt": "estimated, por transcript",
    "en": "estimated, from transcript",
    "es": "estimated, por transcript"
  },
  "t1": {
    "pt": "informada, pelo host",
    "en": "reported by the host",
    "es": "informada por el host"
  },
  "t2": {
    "pt": "Crítico",
    "en": "Critical",
    "es": "Crítico"
  },
  "t3": {
    "pt": "Importante",
    "en": "Important",
    "es": "Importante"
  },
  "t4": {
    "pt": "Resumível",
    "en": "Summarizable",
    "es": "Resumible"
  },
  "t5": {
    "pt": "Vai inline, sempre: estado, decisões locked, critérios, claims.",
    "en": "Always inline: state, locked decisions, criteria and claims.",
    "es": "Siempre incluido: estado, decisiones locked, criterios y claims."
  },
  "t6": {
    "pt": "Vira ponteiro <code>path#âncora</code> com o momento certo de resolver (<code>retrieve_when</code>). Pedido fora do momento volta sem o conteúdo.",
    "en": "A <code>path#anchor</code> pointer with a retrieval condition (<code>retrieve_when</code>). Requests outside that condition return no content.",
    "es": "Un puntero <code>path#ancla</code> con condición de recuperación (<code>retrieve_when</code>). Fuera de esa condición no devuelve contenido."
  },
  "t7": {
    "pt": "Resumo curto, com proveniência obrigatória: <code>source</code>, <code>location</code> e o sha256 do arquivo de origem.",
    "en": "A short summary with required provenance: <code>source</code>, <code>location</code> and the source file’s SHA-256.",
    "es": "Un resumen breve con procedencia obligatoria: <code>source</code>, <code>location</code> y SHA-256 del archivo fuente."
  },
  "t8": {
    "pt": "A fase termina e o gate mede a ocupação da janela de contexto.",
    "en": "When the phase ends, the gate evaluates context-window usage.",
    "es": "Al terminar la fase, el gate evalúa la ocupación de la ventana de contexto."
  },
  "t9": {
    "pt": "Quando nenhuma fonte sabe medir, o veredito sai\n      <code>same-session</code> com <code>decididoPor: ausencia-de-medida</code>.\n      Decidir por dado que não existe é pior do que não decidir.\n      <strong>Uma lacuna nunca vira zero.</strong>",
    "en": "When no source can measure usage, the result is <code>same-session</code> with <code>decididoPor: ausencia-de-medida</code>. <strong>Missing data never becomes zero.</strong>",
    "es": "Sin una fuente capaz de medir, el resultado es <code>same-session</code> con <code>decididoPor: ausencia-de-medida</code>. <strong>Un dato ausente nunca se convierte en cero.</strong>"
  },
  "t10": {
    "pt": "passou de rotate_above?",
    "en": "above rotate_above?",
    "es": "¿superó rotate_above?"
  },
  "t11": {
    "pt": "não",
    "en": "no",
    "es": "no"
  },
  "t12": {
    "pt": "sim",
    "en": "yes",
    "es": "sí"
  },
  "t13": {
    "pt": "Mesma sessão. O trabalho continua onde está.",
    "en": "Same session. Work continues in place.",
    "es": "Misma sesión. El trabajo continúa donde está."
  },
  "t14": {
    "pt": "Nova sessão, com <strong>handoff triado</strong>. Nada de\n        copiar a sessão anterior inteira e entregar uma sessão nova já cheia.",
    "en": "New session with a <strong>triaged handoff</strong>, carrying the context needed for the next step.",
    "es": "Nueva sesión con <strong>handoff clasificado</strong> y el contexto necesario para el siguiente paso."
  },
  "t15": {
    "pt": "A triagem em três níveis",
    "en": "Three levels of context",
    "es": "Tres niveles de contexto"
  },
  "t16": {
    "pt": "Com o OrkMind ligado, o mesmo ponteiro resolve por\n    busca semântica por tag. Com o OrkMind fora do ar, ele resolve por\n    <code>path#âncora</code>, e o fluxo de quem lê o handoff não muda em nada. A\n    degradação tem motivo tipado.",
    "en": "With OrkMind available, pointers can resolve through memory. File fallback uses <code>path#anchor</code>, with a typed reason for degraded operation.",
    "es": "Con OrkMind disponible, los punteros pueden resolverse mediante la memoria. El respaldo por archivos usa <code>path#ancla</code>, con motivo tipado de degradación."
  }
};
const t=(key:keyof typeof translations)=>translations[key][locale];
// O gate de tokens e o handoff triado em tres niveis.
// A janela de contexto acaba no meio da thread; o ork mede, decide e tria o que passa.

const fontes = [
  { nome: 'runtime_reported', existe: true },
  { nome: t("t0"), existe: true },
  { nome: t("t1"), existe: true },
  { nome: 'unavailable', existe: false }
];

const niveis = [
  {
    nome: t("t2"),
    cor: 'latao',
    desc: t("t5")
  },
  {
    nome: t("t3"),
    cor: 'brasa',
    desc: t("t6")
  },
  {
    nome: t("t4"),
    cor: 'patina',
    desc: t("t7")
  }
];
---

<div class="gate grade-flexivel">
  <div class="gate-fluxo" data-anima>
    <div class="painel etapa">
      <p class="micro-rotulo sem-ponto">ork gate next</p>
      <p class="etapa-texto">{t("t8")}</p>

      <ul class="fontes mono">
        {fontes.map((fonte) => (
          <li class={fonte.existe ? '' : 'fonte-ausente'}>
            <span class="fonte-marca" aria-hidden="true"></span>
            {fonte.nome}
          </li>
        ))}
      </ul>

      <p class="etapa-nota"><Fragment set:html={t("t9")} /></p>
    </div>

    <div class="decisao" aria-hidden="true">
      <span class="decisao-fio"></span>
      <span class="decisao-losango">
        <span class="decisao-pergunta mono">{t("t10")}</span>
      </span>
      <span class="decisao-fio"></span>
    </div>

    <div class="saidas">
      <div class="painel saida">
        <p class="mono saida-tag">{t("t11")}</p>
        <p class="etapa-texto">{t("t13")}</p>
      </div>
      <div class="painel painel-latao saida">
        <p class="mono saida-tag saida-tag-latao">{t("t12")}</p>
        <p class="etapa-texto"><Fragment set:html={t("t14")} /></p>
      </div>
    </div>
  </div>

  <div class="triagem">
    <p class="titulo-3">{t("t15")}</p>

    <ol class="niveis escalona">
      {niveis.map((nivel, indice) => (
        <li class={`nivel nivel-${nivel.cor}`}>
          <span class="nivel-ordem mono" aria-hidden="true">{String(indice + 1).padStart(2, '0')}</span>
          <div>
            <p class="nivel-nome mono">{nivel.nome}</p>
            <p class="nivel-desc" set:html={nivel.desc} />
          </div>
        </li>
      ))}
    </ol>

    <p class="triagem-nota paragrafo"><Fragment set:html={t("t16")} /></p>
  </div>
</div>

<style>
  .gate {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .etapa-texto {
    margin-top: 0.7rem;
    color: var(--tinta-2);
    font-size: var(--t-small);
  }

  .etapa-texto :global(strong) {
    color: var(--tinta);
    font-variation-settings: 'wght' 560;
  }

  /* ---------- fontes de medida ---------- */

  .fontes {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .fontes li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-pilula);
    padding: 0.3rem 0.85rem;
    font-size: var(--t-nano);
    color: var(--tinta-2);
    background: var(--poco);
    transition: border-color var(--dur-2) var(--curva);
  }

  .fonte-marca {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--patina);
  }

  /* A fonte que nao existe e desenhada como ausencia, nao como zero */
  .fonte-ausente {
    border-style: dashed;
    color: var(--brasa-clara);
    border-color: var(--brasa-linha);
  }

  .fonte-ausente .fonte-marca {
    background: none;
    border: 1px solid var(--brasa);
  }

  .etapa-nota {
    margin-top: 1.1rem;
    font-size: var(--t-micro);
    color: var(--tinta-3);
    line-height: 1.75;
  }

  .etapa-nota strong {
    color: var(--tinta);
    font-variation-settings: 'wght' 560;
  }

  /* ---------- decisao ---------- */

  .decisao {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.15rem 0;
  }

  .decisao-fio {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--latao-linha), transparent);
  }

  .decisao-losango {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 1rem;
    border: 1px solid var(--latao-linha);
    border-radius: var(--raio-pilula);
    background: var(--latao-fraco);
    box-shadow: var(--lustro);
  }

  .decisao-pergunta {
    font-size: var(--t-nano);
    color: var(--latao-claro);
    white-space: nowrap;
    letter-spacing: 0.04em;
  }

  .saidas {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 1rem;
    align-items: start;
  }

  .saida {
    padding: 1.2rem 1.3rem;
  }

  .saida-tag {
    display: inline-block;
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-pilula);
    padding: 0.12rem 0.85rem;
    font-size: var(--t-nano);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--tinta-3);
  }

  .saida-tag-latao {
    border-color: transparent;
    background: linear-gradient(135deg, var(--latao-claro), var(--latao));
    color: var(--sobre-latao);
    font-variation-settings: 'wght' 550;
  }

  /* ---------- triagem ---------- */

  .niveis {
    list-style: none;
    padding: 0;
    margin: 1.6rem 0 0;
    display: grid;
    gap: 0.7rem;
  }

  .nivel {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
    border-left: 2px solid var(--linha-forte);
    border-radius: 0 var(--raio-campo) var(--raio-campo) 0;
    padding: 0.85rem 1rem 0.85rem 1.1rem;
    transition: border-color var(--dur-2) var(--curva), background var(--dur-2) var(--curva),
      transform var(--dur-2) var(--curva);
  }

  .nivel:hover {
    background: var(--palco);
    transform: translateX(3px);
  }

  .nivel-ordem {
    font-size: var(--t-nano);
    color: var(--tinta-3);
    padding-top: 0.15rem;
  }

  .nivel-latao {
    border-left-color: var(--latao);
  }

  .nivel-brasa {
    border-left-color: var(--brasa);
  }

  .nivel-patina {
    border-left-color: var(--patina);
  }

  .nivel-latao:hover { border-left-color: var(--latao-claro); }
  .nivel-brasa:hover { border-left-color: var(--brasa-clara); }
  .nivel-patina:hover { border-left-color: var(--patina-clara); }

  .nivel-nome {
    font-size: var(--t-micro);
    letter-spacing: 0.18em;
    color: var(--tinta);
    font-variation-settings: 'wght' 500;
  }

  .nivel-desc {
    margin-top: 0.4rem;
    font-size: var(--t-small);
    color: var(--tinta-2);
  }

  .triagem-nota {
    margin-top: 1.8rem;
    font-size: var(--t-small);
  }

  @media (max-width: 900px) {
    .gate {
      grid-template-columns: 1fr;
    }

    .saidas {
      grid-template-columns: 1fr;
    }
  }
</style>
