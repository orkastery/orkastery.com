---
// Rodapé do design: escuro, com a assinatura clara, a frase, três colunas e a linha final.
// No design os links são "#"; aqui cada um tem destino real (D8 da thread).
import {localeFor,localize,moldura,destinosExternos,withBase} from '../data/i18n';
const locale=localeFor(Astro.url.pathname),m=moldura(locale);
const destino=(alvo:string)=>alvo.startsWith('/')?localize(alvo,locale):destinosExternos[alvo];
---
<footer class="rodape sobre-escuro">
 <div class="rodape-grade">
  <div class="rodape-marca">
   <img src={withBase('/marca/assinatura-fundo-escuro.svg')} alt="Orkastery" width="142" height="28"/>
   <p>{m.tagline}</p>
  </div>
  {m.columns.map((col,i)=><nav class="rodape-coluna" aria-labelledby={'rodape-'+i}>
   <span class="rodape-titulo" id={'rodape-'+i}>{col.title}</span>
   {col.links.map(([label,alvo])=><a href={destino(alvo)}>{label}</a>)}
  </nav>)}
 </div>
 <div class="rodape-base"><span>{m.rights}</span><span lang="en">{m.pronunciation}</span></div>
</footer>
<style>
.rodape{background:var(--noite);color:var(--sobre-noite-3);border-top:1px solid var(--grafite)}
.rodape-grade{max-width:var(--largura-maxima);margin:0 auto;padding:56px var(--calha) 40px;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:36px}
.rodape-marca{grid-column:span 2;min-width:260px}
.rodape-marca img{height:28px;width:auto}
.rodape-marca p{margin:20px 0 0;max-width:40ch;font:400 15px/1.6 var(--fonte-texto);color:var(--sobre-noite-3)}
.rodape-coluna{display:flex;flex-direction:column;gap:12px;font:400 14px/1.3 var(--fonte-texto)}
.rodape-titulo{font:500 12px/1 var(--fonte-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--sobre-noite-4)}
.rodape-coluna a{color:var(--sobre-noite-2)}
.rodape-base{max-width:var(--largura-maxima);margin:0 auto;padding:20px var(--calha) 32px;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;font:400 12.5px/1.4 var(--fonte-mono);color:var(--sobre-noite-4);border-top:1px solid var(--grafite)}
</style>
