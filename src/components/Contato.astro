---
// Formulario estatico: monta um mailto para maestro@orkastery.com.
// Sem JS, o link direto de email continua funcionando e o form usa validacao nativa.
---

<section class="secao contato" id="contato" aria-labelledby="contato-titulo">
  <div class="contato-aura" aria-hidden="true"></div>

  <div class="container grade-contato grade-flexivel">
    <div class="contato-texto">
      <p class="micro-rotulo revela">contato</p>
      <h2 class="display revela" id="contato-titulo" style="--atraso: 0.06s">Fale com quem rege</h2>
      <p class="paragrafo intro revela" style="--atraso: 0.12s">
        Dúvida sobre o método, proposta de contribuição ou vontade de conduzir a sua
        própria fábrica: escreva. A resposta vem de gente, não de agente.
      </p>

      <a class="email-direto revela" style="--atraso: 0.18s" href="mailto:maestro@orkastery.com">
        <span class="email-icone" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16">
            <rect x="1.5" y="3.5" width="13" height="9" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3" />
            <path d="M2 4.6 8 9l6-4.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="mono">maestro@orkastery.com</span>
      </a>

      <p class="contato-promessa mono revela" style="--atraso: 0.24s">
        <span class="promessa-luz" aria-hidden="true"></span>
        resposta em até dois dias úteis
      </p>
    </div>

    <form class="painel formulario revela" data-contato style="--atraso: 0.1s" novalidate>
      <div class="campo">
        <input id="contato-nome" name="nome" type="text" autocomplete="name" placeholder=" " required />
        <label for="contato-nome">Seu nome</label>
        <p class="erro" data-erro-de="nome" aria-live="polite"></p>
      </div>

      <div class="campo">
        <input id="contato-email" name="email" type="email" autocomplete="email" placeholder=" " required />
        <label for="contato-email">Seu email</label>
        <p class="ajuda">Usado só para a resposta chegar até você.</p>
        <p class="erro" data-erro-de="email" aria-live="polite"></p>
      </div>

      <div class="campo">
        <textarea id="contato-mensagem" name="mensagem" rows="5" placeholder=" " required></textarea>
        <label for="contato-mensagem">Mensagem</label>
        <p class="erro" data-erro-de="mensagem" aria-live="polite"></p>
      </div>

      <button class="botao botao-latao envio" type="submit">
        <span data-rotulo-envio>Enviar mensagem</span>
        <svg class="seta" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M2 7h9M7.5 3.5 11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <p class="ajuda envio-nota">O envio abre o seu aplicativo de email com tudo preenchido.</p>
    </form>
  </div>
</section>

<style>
  .contato {
    position: relative;
    overflow: hidden;
  }

  .contato-aura {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(45% 55% at 88% 20%, rgba(224, 178, 100, 0.08), transparent 62%),
      radial-gradient(38% 42% at 6% 92%, rgba(111, 185, 168, 0.05), transparent 66%);
  }

  .grade-contato {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .contato-texto h2 {
    margin-top: 1rem;
  }

  .intro {
    margin-top: 1.3rem;
  }

  /* ---------- email direto ---------- */

  .email-direto {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2.2rem;
    padding: 0.75rem 1.2rem;
    border: 1px solid var(--latao-linha);
    border-radius: var(--raio-pilula);
    background: linear-gradient(180deg, rgba(224, 178, 100, 0.08), transparent), var(--palco);
    box-shadow: var(--lustro);
    color: var(--latao-claro);
    text-decoration: none;
    font-size: 1rem;
    transition: border-color var(--dur-2) var(--curva), transform var(--dur-2) var(--curva),
      box-shadow var(--dur-2) var(--curva);
  }

  .email-direto:hover {
    border-color: var(--latao-forte);
    transform: translateY(-2px);
    box-shadow: var(--lustro), var(--aura-latao);
  }

  .email-icone {
    display: grid;
    place-items: center;
    opacity: 0.85;
  }

  .contato-promessa {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.4rem;
    font-size: var(--t-nano);
    color: var(--tinta-3);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .promessa-luz {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--patina);
    box-shadow: 0 0 10px rgba(111, 185, 168, 0.7);
  }

  /* ---------- formulario ---------- */

  .formulario {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .campo {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: 0.55rem;
  }

  /* Rotulo flutuante: a etiqueta descansa dentro do campo quando ele esta vazio
     e sem foco, e sobe para cima da borda assim que ha conteudo ou foco.
     A etiqueta nunca some, e por isso o campo nunca depende de placeholder. */
  .campo label {
    position: absolute;
    left: 1.05rem;
    top: 1.4rem;
    font-size: 1rem;
    color: var(--tinta-3);
    pointer-events: none;
    transform-origin: left center;
    transition: transform var(--dur-2) var(--curva), color var(--dur-2) var(--curva);
  }

  .campo input,
  .campo textarea {
    background: var(--poco);
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-campo);
    color: var(--tinta);
    font: inherit;
    padding: 0.85rem 1.05rem;
    box-shadow: inset 0 1px 3px rgba(6, 4, 2, 0.5);
    transition: border-color var(--dur-2) var(--curva), box-shadow var(--dur-2) var(--curva),
      background var(--dur-2) var(--curva);
  }

  .campo textarea {
    resize: vertical;
    min-height: 8.5rem;
    line-height: 1.6;
  }

  .campo input:focus,
  .campo textarea:focus {
    outline: none;
    border-color: var(--latao);
    box-shadow: inset 0 1px 3px rgba(6, 4, 2, 0.5), 0 0 0 3px var(--latao-fraco);
  }

  .campo input:focus + label,
  .campo textarea:focus + label,
  .campo input:not(:placeholder-shown) + label,
  .campo textarea:not(:placeholder-shown) + label {
    transform: translate(-0.1rem, -1.95rem) scale(0.76);
    color: var(--latao);
  }

  .campo input:not(:placeholder-shown) + label,
  .campo textarea:not(:placeholder-shown) + label {
    color: var(--tinta-3);
  }

  .campo[data-invalido='sim'] input,
  .campo[data-invalido='sim'] textarea {
    border-color: var(--brasa-linha);
  }

  .campo[data-invalido='sim'] input:focus,
  .campo[data-invalido='sim'] textarea:focus {
    border-color: var(--brasa);
    box-shadow: inset 0 1px 3px rgba(6, 4, 2, 0.5), 0 0 0 3px var(--brasa-fraca);
  }

  .ajuda {
    margin-top: 0.45rem;
    color: var(--tinta-3);
    font-size: var(--t-micro);
  }

  .erro {
    margin-top: 0.4rem;
    color: var(--brasa-clara);
    font-size: var(--t-micro);
  }

  .erro:empty {
    display: none;
  }

  .envio {
    align-self: flex-start;
    border: none;
    margin-top: 0.2rem;
  }

  .envio[data-estado='enviado'] {
    background: linear-gradient(135deg, var(--patina-clara), var(--patina));
    color: var(--sobre-patina);
  }

  .envio-nota {
    text-align: center;
    margin-top: 0;
  }

  @media (max-width: 900px) {
    .grade-contato {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const MENSAGENS: Record<string, string> = {
    nome: 'Diga como devemos chamar você.',
    email: 'Um email válido, para a resposta ter onde chegar.',
    mensagem: 'Escreva a mensagem antes de enviar.'
  };

  const formulario = document.querySelector<HTMLFormElement>('[data-contato]');

  function validarCampo(controle: HTMLInputElement | HTMLTextAreaElement) {
    const campo = controle.closest<HTMLElement>('.campo');
    const aviso = campo?.querySelector<HTMLElement>('[data-erro-de]');
    const valido = controle.checkValidity();
    if (campo) campo.dataset.invalido = valido ? 'nao' : 'sim';
    if (aviso) aviso.textContent = valido ? '' : (MENSAGENS[controle.name] ?? 'Campo obrigatório.');
    controle.setAttribute('aria-invalid', String(!valido));
    return valido;
  }

  if (formulario) {
    const controles = Array.from(
      formulario.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')
    );

    for (const controle of controles) {
      // So valida depois que a pessoa saiu do campo: erro no meio da digitacao atrapalha
      controle.addEventListener('blur', () => validarCampo(controle));
      controle.addEventListener('input', () => {
        if (controle.closest('.campo')?.getAttribute('data-invalido') === 'sim') {
          validarCampo(controle);
        }
      });
    }

    formulario.addEventListener('submit', (evento) => {
      evento.preventDefault();

      const invalidos = controles.filter((controle) => !validarCampo(controle));
      if (invalidos.length > 0) {
        invalidos[0].focus();
        return;
      }

      const dados = new FormData(formulario);
      const nome = String(dados.get('nome') ?? '');
      const email = String(dados.get('email') ?? '');
      const mensagem = String(dados.get('mensagem') ?? '');
      const assunto = encodeURIComponent(`Contato pelo portal Orkastery: ${nome}`);
      const corpo = encodeURIComponent(`${mensagem}\n\nDe: ${nome} <${email}>`);

      const botao = formulario.querySelector<HTMLButtonElement>('[type="submit"]');
      const rotulo = botao?.querySelector<HTMLElement>('[data-rotulo-envio]');
      if (botao && rotulo) {
        botao.dataset.estado = 'enviado';
        rotulo.textContent = 'abrindo seu email';
        window.setTimeout(() => {
          delete botao.dataset.estado;
          rotulo.textContent = 'Enviar mensagem';
        }, 2600);
      }

      window.location.href = `mailto:maestro@orkastery.com?subject=${assunto}&body=${corpo}`;
    });
  }
</script>
