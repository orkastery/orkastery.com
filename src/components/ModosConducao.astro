---
import TechnicalText from './TechnicalText.astro';
import {richTechnicalHtml} from '../lib/technical-text.mjs';
import {localeFor, localize} from '../data/i18n';
const locale=localeFor(Astro.url.pathname);
const translations={
  "t0": {
    "pt": "pausas",
    "en": "pauses",
    "es": "pausas"
  },
  "t1": {
    "pt": "supervisão humana",
    "en": "human oversight",
    "es": "supervisión humana"
  },
  "t2": {
    "pt": "autonomia total",
    "en": "autonomy",
    "es": "autonomía"
  },
  "t3": {
    "pt": "padrão",
    "en": "default",
    "es": "predeterminado"
  },
  "t4": {
    "pt": "em breve",
    "en": "coming soon",
    "es": "próximamente"
  },
  "t5": {
    "pt": "pausa sobre",
    "en": "pause to decide",
    "es": "pausa para decidir"
  },
  "t6": {
    "pt": "use quando",
    "en": "use when",
    "es": "úselo cuando"
  },
  "t7": {
    "pt": "slugs de sessão",
    "en": "session slugs",
    "es": "slugs de sesión"
  },
  "t8": {
    "pt": "bloco que pausa e espera o veredito humano",
    "en": "block that pauses for a human decision",
    "es": "bloque que espera una decisión humana"
  },
  "t9": {
    "pt": "bloco que segue sozinho, com decisão no ledger",
    "en": "block that proceeds with decisions recorded in the ledger",
    "es": "bloque que continúa con decisiones registradas en el ledger"
  },
  "t10": {
    "pt": "O modo afrouxa a pausa. O modo <em>nunca</em> afrouxa a verificação.\n      Com Claude Code (<code>claude-bg</code>) e Codex (<code>codex</code>) homologados,\n      cada bloco pode abrir com runtime, modelo e esforço próprios, pelo\n      <code class=\"mono\">ork setup</code>.",
    "en": "Modes change pauses. They <em>never</em> relax verification. Configure each block’s runtime, model and effort with <code>ork setup</code>.",
    "es": "Los modos cambian las pausas. <em>Nunca</em> reducen la verificación. Configure runtime, modelo y esfuerzo de cada bloque con <code>ork setup</code>."
  },
  "t11": {
    "pt": "explorar cada modo no Ork →",
    "en": "explore every mode in Ork →",
    "es": "explorar cada modo de Ork →"
  }
};
const t=(key:keyof typeof translations)=>translations[key][locale];
// O espectro de conducao na home: os 4 modos de uma vez, do que mais pausa ao mais
// leve, desenhados sobre o eixo das 6 fases canonicas. Latao marca o bloco
// que PARA e espera o veredito humano; patina marca o bloco que segue sozinho com
// registro no ledger. Clicar numa linha abre o detalhe do modo, sem sair da pagina.
// Fonte do conteudo: src/data/modos.ts, espelho de `ork modos`.
import { FASES_CANONICAS, modosFor } from '../data/modos';

// Small local UI symbols: checkpoints, connected agents, flow and fast track.
const MODOS_DE_CONDUCAO=modosFor(locale);
const modeIcons: Record<string, string[]> = {
  classic: ['M4 5h16v14H4Z', 'm7 12 3 3 7-7'],
  maestro: ['M9 3h6v6H9Z', 'M3 15h6v6H3Zm12 0h6v6h-6Z', 'M12 9v3H6v3m6-3h6v3'],
  auto: ['M4 12h16m-5-5 5 5-5 5', 'M4 5v14'],
  fast: ['m4 6 7 6-7 6m9-12 7 6-7 6'],
};
---

<div class="modos" data-modos>
  <div class="modos-eixo" aria-hidden="true">
    <span class="eixo-vazio"></span>
    <div class="eixo-fases mono">
      {FASES_CANONICAS.map((fase) => (
        <span class="eixo-fase">{fase}</span>
      ))}
    </div>
    <span class="eixo-pausas mono">{t("t0")}</span>
  </div>

  <div class="modos-corpo">
    <div class="modos-trilho" aria-hidden="true">
      <span class="trilho-rotulo mono">{t("t1")}</span>
      <span class="trilho-fio"></span>
      <span class="trilho-rotulo mono">{t("t2")}</span>
    </div>

    <ul class="modos-linhas">
      {MODOS_DE_CONDUCAO.map((modo, indice) => (
        <li class="modo-item">
          <button
            type="button"
            class="modo-linha"
            aria-expanded="false"
            aria-controls={`modo-detalhe-${modo.modo}`}
            data-modo-linha
            style={`--ordem: ${indice}`}
          >
            <span class="modo-tag mono">
              <svg class="mode-icon" data-mode-icon={modo.modo} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                {modeIcons[modo.modo].map((d) => <path d={d} />)}
              </svg>
              {modo.tag}
              {modo.padrao && <span class="modo-padrao">{t("t3")}</span>}
              {modo.emBreve && <span class="modo-breve">{t("t4")}</span>}
            </span>
            <span class="modo-trilha" role="img" aria-label={`${locale === "en" ? "Cycle" : "Ciclo"} ${modo.ciclo.map((b) => b.fases).join(', ')}`}>
              {modo.ciclo.map((bloco) => (
                <span
                  class={`modo-bloco mono ${bloco.pausa ? 'modo-bloco-pausa' : 'modo-bloco-auto'}`}
                  style={`--largura: ${bloco.largura}${bloco.inicio ? `; grid-column: ${bloco.inicio} / span ${bloco.largura}` : ''}`}
                >
                  <span class="bloco-texto">{bloco.fases}</span>
                  {bloco.pausa && <span class="bloco-ponto" aria-hidden="true"></span>}
                </span>
              ))}
            </span>
            <span class="modo-pausas numeral" data-pausas={modo.pausas}>
              {modo.pausas}
            </span>
          </button>

          <div class="modo-detalhe" id={`modo-detalhe-${modo.modo}`} hidden>
            <dl class="detalhe-grade">
              <div>
                <dt class="mono">{t("t5")}</dt>
                <dd><TechnicalText text={modo.pausaSobre}/></dd>
              </div>
              <div>
                <dt class="mono">{t("t6")}</dt>
                <dd><TechnicalText text={modo.uso}/></dd>
              </div>
              <div>
                <dt class="mono">{t("t7")}</dt>
                <dd class="mono">{modo.slugs}</dd>
              </div>
            </dl>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <div class="modos-legenda">
    <p class="legenda-item mono">
      <span class="legenda-amostra legenda-pausa" aria-hidden="true"></span>
      {t("t8")}
    </p>
    <p class="legenda-item mono">
      <span class="legenda-amostra legenda-auto" aria-hidden="true"></span>
      {t("t9")}
    </p>
    <p class="legenda-regra">
      <Fragment set:html={richTechnicalHtml(t("t10"))} />
    </p>
    <a class="legenda-link mono" href={localize("/docs/modos/",locale)}>{t("t11")}</a>
  </div>
</div>

<style>
  .mode-icon {
    flex: 0 0 auto;
    color: var(--latao);
    opacity: 0.85;
  }

  .modo-linha[aria-expanded='true'] .mode-icon {
    color: var(--patina);
    opacity: 1;
  }

  .modos {
    display: grid;
    gap: 1.6rem;
  }

  /* ---------- eixo das fases ---------- */

  .modos-eixo {
    display: grid;
    grid-template-columns: minmax(7.2rem, auto) 1fr 3.4rem;
    gap: 1rem;
    align-items: end;
    padding-inline-start: 1.9rem;
  }

  .eixo-fases {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
  }

  .eixo-fase {
    font-size: var(--t-nano);
    letter-spacing: var(--tracking-label);
    color: var(--tinta-4);
    text-align: center;
    padding-bottom: 0.4rem;
    border-bottom: 1px dashed var(--linha);
  }

  .eixo-pausas {
    font-size: var(--t-nano);
    letter-spacing: var(--tracking-label);
    color: var(--tinta-4);
    text-align: center;
    padding-bottom: 0.4rem;
  }

  /* ---------- trilho do espectro ---------- */

  .modos-corpo {
    display: grid;
    grid-template-columns: 0.9rem 1fr;
    gap: 1rem;
  }

  .modos-trilho {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    gap: 0.7rem;
  }

  .trilho-rotulo {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: var(--t-nano);
    letter-spacing: var(--tracking-label);
    text-transform: none;
    color: var(--tinta-4);
    white-space: nowrap;
  }

  .trilho-fio {
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--latao), var(--latao-linha) 45%, var(--patina-linha) 60%, var(--patina));
    box-shadow: 0 0 14px color-mix(in srgb, var(--acento) 25%, transparent);
  }

  /* ---------- linhas dos modos ---------- */

  .modos-linhas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .modo-linha {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(7.2rem, auto) 1fr 3.4rem;
    gap: 1rem;
    align-items: center;
    text-align: left;
    background: linear-gradient(180deg, color-mix(in srgb, var(--tinta) 3%, transparent), transparent), var(--painel);
    border: 1px solid var(--linha);
    border-radius: var(--raio-campo);
    padding: 0.75rem 0.9rem;
    cursor: pointer;
    color: inherit;
    box-shadow: var(--lustro);
    transition:
      border-color var(--dur-2) var(--curva),
      transform var(--dur-2) var(--curva),
      box-shadow var(--dur-2) var(--curva);
  }

  .modo-linha:hover {
    border-color: var(--latao-linha);
    transform: translateY(-2px);
    box-shadow: var(--lustro-forte), var(--sombra-1);
  }

  .modo-linha:active {
    transform: translateY(0) scale(0.995);
  }

  .modo-linha:focus-visible {
    outline: 2px solid var(--latao);
    outline-offset: 3px;
  }

  .modo-linha[aria-expanded='true'] {
    border-color: var(--latao-linha);
    box-shadow: var(--lustro-forte), var(--aura-latao);
  }

  .modo-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--t-small);
    color: var(--tinta);
    font-variation-settings: 'wght' 520;
    white-space: nowrap;
  }

  .modo-breve {
    margin-left: 0.35rem;
    font-size: var(--t-nano);
    letter-spacing: var(--tracking-label);
    text-transform: none;
    color: var(--tinta-3);
    border: 1px dashed var(--linha-viva);
    border-radius: var(--raio-pilula);
    padding: 0.05rem 0.4rem;
  }

  .modo-padrao {
    border: 1px solid var(--latao-linha);
    border-radius: var(--raio-pilula);
    color: var(--latao);
    padding: 0.02rem 0.5rem;
    font-size: var(--t-nano);
    letter-spacing: var(--tracking-label);
  }

  /* A trilha: os blocos do ciclo desenhados sobre as 6 fases, na proporcao real */
  .modo-trilha {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
    min-height: 2.35rem;
  }

  .modo-bloco {
    grid-column: span var(--largura);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-size: var(--t-nano);
    letter-spacing: var(--tracking-label);
    border-radius: 7px;
    padding: 0.35rem 0.3rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .modo-bloco-pausa {
    background: linear-gradient(180deg, var(--latao-fraco), color-mix(in srgb, var(--acento) 5%, transparent));
    border: 1px solid var(--latao-linha);
    color: var(--latao-claro);
    box-shadow: var(--lustro);
  }

  .bloco-ponto {
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--latao);
    box-shadow: 0 0 8px color-mix(in srgb, var(--acento) 80%, transparent);
  }

  .modo-bloco-auto {
    background: var(--patina-fraca);
    border: 1px dashed var(--patina-linha);
    color: var(--patina-clara);
  }

  .bloco-texto {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .modo-pausas {
    font-size: 1.35rem;
    text-align: center;
    color: var(--latao);
    font-variation-settings: 'wght' 480;
  }

  .modo-pausas[data-pausas='0'] {
    color: var(--patina);
  }

  /* ---------- detalhe expandido ---------- */

  .modo-detalhe {
    padding: 0.9rem 1rem 1.1rem calc(7.2rem + 1.9rem);
  }

  .detalhe-grade {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .detalhe-grade dt {
    font-size: var(--t-nano);
    letter-spacing: var(--tracking-label);
    text-transform: none;
    color: var(--tinta-4);
    margin-bottom: 0.35rem;
  }

  .detalhe-grade dd {
    margin: 0;
    font-size: var(--t-small);
    color: var(--tinta-2);
    line-height: 1.55;
  }

  /* ---------- legenda ---------- */

  .modos-legenda {
    display: grid;
    gap: 0.6rem;
    padding-inline-start: 1.9rem;
  }

  .legenda-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--t-micro);
    color: var(--tinta-3);
  }

  .legenda-amostra {
    width: 1.6rem;
    height: 0.85rem;
    border-radius: 5px;
  }

  .legenda-pausa {
    background: var(--latao-fraco);
    border: 1px solid var(--latao-linha);
  }

  .legenda-auto {
    background: var(--patina-fraca);
    border: 1px dashed var(--patina-linha);
  }

  .legenda-regra {
    margin: 0.4rem 0 0;
    max-width: 62ch;
    font-size: var(--t-small);
    color: var(--tinta-2);
    line-height: 1.6;
  }

  .legenda-regra em {
    color: var(--latao);
    font-style: normal;
  }

  .legenda-regra code {
    color: var(--patina-clara);
    font-size: 0.92em;
  }

  .legenda-link {
    justify-self: start;
    font-size: var(--t-micro);
    letter-spacing: var(--tracking-label);
    color: var(--latao);
    text-decoration: none;
    border-bottom: 1px solid var(--latao-linha);
    padding-bottom: 0.15rem;
    transition: color var(--dur-2) var(--curva), border-color var(--dur-2) var(--curva);
  }

  .legenda-link:hover {
    color: var(--latao-claro);
    border-color: var(--latao-forte);
  }

  /* ---------- responsivo ---------- */

  @media (max-width: 860px) {
    .modos-eixo,
    .modos-legenda {
      padding-inline-start: 0;
    }

    .modos-eixo {
      grid-template-columns: 1fr;
    }

    .eixo-vazio,
    .eixo-pausas {
      display: none;
    }

    .modos-corpo {
      grid-template-columns: 1fr;
    }

    .modos-trilho {
      display: none;
    }

    .modo-linha {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'tag pausas'
        'trilha trilha';
      row-gap: 0.7rem;
    }

    .modo-tag {
      grid-area: tag;
    }

    .modo-trilha {
      grid-area: trilha;
    }

    .modo-pausas {
      grid-area: pausas;
    }

    .bloco-texto {
      display: none;
    }

    .modo-bloco {
      min-height: 1.1rem;
    }

    .modo-bloco .bloco-ponto {
      margin: 0;
    }

    .modo-detalhe {
      padding: 0.8rem 0.2rem 1rem;
    }

    .detalhe-grade {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>

<script>
  // Uma linha aberta por vez: o detalhe e leitura, nao formulario. Sem JS a secao
  // continua legivel inteira (os detalhes ficam fechados, o resto e estatico).
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-modos]')) {
    const linhas = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-modo-linha]'));
    for (const linha of linhas) {
      linha.addEventListener('click', () => {
        const aberto = linha.getAttribute('aria-expanded') === 'true';
        for (const outra of linhas) {
          outra.setAttribute('aria-expanded', 'false');
          const painel = document.getElementById(outra.getAttribute('aria-controls') ?? '');
          if (painel) painel.hidden = true;
        }
        if (!aberto) {
          linha.setAttribute('aria-expanded', 'true');
          const painel = document.getElementById(linha.getAttribute('aria-controls') ?? '');
          if (painel) painel.hidden = false;
        }
      });
    }
  }
</script>
