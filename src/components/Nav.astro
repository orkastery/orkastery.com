---
import Externo from './Externo.astro';

const rota = Astro.url.pathname;
const ativo = (prefixo: string) =>
  prefixo === '/' ? rota === '/' : rota === prefixo || rota.startsWith(prefixo + '/');

const paginas = [
  { href: '/', rotulo: 'A organização', prefixo: '/' },
  { href: '/ork/', rotulo: 'O produto Ork', prefixo: '/ork' },
  { href: '/docs/', rotulo: 'Docs', prefixo: '/docs' },
  { href: '/orkmind/', rotulo: 'OrkMind', prefixo: '/orkmind' }
];
---

<header class="navegacao" data-cabecalho>
  <div class="container barra">
    <a class="marca" href="/" aria-label="Orkastery, página inicial">
      <span class="marca-selo" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 32 32">
          <circle class="selo-orbita" cx="16" cy="16" r="12.4" />
          <circle class="selo-batuta" cx="16" cy="3.6" r="2.8" />
          <circle class="selo-naipe" cx="26.7" cy="9.8" r="2.1" />
          <circle class="selo-naipe" cx="26.7" cy="22.2" r="2.1" />
          <circle class="selo-naipe" cx="16" cy="28.4" r="2.1" />
          <circle class="selo-naipe" cx="5.3" cy="22.2" r="2.1" />
          <circle class="selo-naipe" cx="5.3" cy="9.8" r="2.1" />
        </svg>
      </span>
      <span class="marca-nome">Orkastery</span>
    </a>

    <button
      class="menu-botao"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-botao
    >
      <span class="menu-linha" aria-hidden="true"></span>
      <span class="visualmente-oculto">Abrir menu de navegação</span>
    </button>

    <nav id="menu-principal" class="menu" aria-label="Navegação principal">
      <span class="menu-indicador" aria-hidden="true" data-indicador></span>
      {paginas.map((pagina) => (
        <a
          class="menu-item"
          href={pagina.href}
          data-item
          aria-current={ativo(pagina.prefixo) ? 'page' : undefined}
        >
          {pagina.rotulo}
        </a>
      ))}
      <Externo destino="orkastery" class="menu-item" data-item>
        GitHub
      </Externo>
      <a class="botao botao-latao menu-cta" href="/#contato">
        Falar com a org
        <svg class="seta" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M2 7h9M7.5 3.5 11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </nav>
  </div>
  <span class="barra-fio" aria-hidden="true"></span>
</header>

<style>
  .navegacao {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    background: transparent;
    transition: background var(--dur-3) var(--curva),
      backdrop-filter var(--dur-3) var(--curva), box-shadow var(--dur-3) var(--curva);
  }

  .navegacao.cabecalho-descolado {
    background: var(--vidro);
    -webkit-backdrop-filter: blur(22px) saturate(1.35);
    backdrop-filter: blur(22px) saturate(1.35);
    box-shadow: 0 1px 0 var(--linha), 0 12px 40px -24px rgba(6, 4, 2, 0.9);
  }

  /* O fio de latao so acende quando a barra descola do topo */
  .barra-fio {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--latao-linha) 25%, var(--latao-linha) 75%, transparent);
    opacity: 0;
    transition: opacity var(--dur-3) var(--curva);
  }

  .navegacao.cabecalho-descolado .barra-fio {
    opacity: 1;
  }

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 1rem;
    transition: height var(--dur-3) var(--curva);
  }

  .navegacao.cabecalho-descolado .barra {
    height: 64px;
  }

  /* ---------- marca ---------- */

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--tinta);
  }

  .marca-selo {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
  }

  .marca-selo svg {
    overflow: visible;
  }

  .selo-orbita {
    fill: none;
    stroke: var(--linha-viva);
    stroke-width: 1.3;
    transition: stroke var(--dur-3) var(--curva);
  }

  .selo-batuta {
    fill: var(--latao);
    transform-origin: 16px 16px;
    transition: transform 0.9s var(--curva), fill var(--dur-3) var(--curva);
  }

  .selo-naipe {
    fill: var(--tinta-3);
    transition: fill var(--dur-3) var(--curva);
  }

  .marca:hover .selo-batuta {
    transform: rotate(72deg);
  }

  .marca:hover .selo-orbita {
    stroke: var(--latao-linha);
  }

  .marca:hover .selo-naipe {
    fill: var(--tinta-2);
  }

  .marca-nome {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 30, 'wght' 600, 'SOFT' 0, 'WONK' 0;
    font-size: 1.22rem;
    letter-spacing: -0.02em;
  }

  /* ---------- menu ---------- */

  .menu {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.6vw, 1.1rem);
  }

  .menu-item {
    position: relative;
    z-index: 1;
    padding: 0.5rem 0.85rem;
    border-radius: var(--raio-pilula);
    text-decoration: none;
    color: var(--tinta-3);
    font-size: 0.94rem;
    font-variation-settings: 'wght' 480;
    letter-spacing: -0.008em;
    white-space: nowrap;
    transition: color var(--dur-2) var(--curva);
  }

  .menu-item:hover {
    color: var(--tinta);
  }

  .menu-item[aria-current='page'] {
    color: var(--latao-claro);
  }

  /* A pilula que desliza para o item sob o ponteiro. Posicao vem do script. */
  .menu-indicador {
    position: absolute;
    top: 50%;
    left: 0;
    height: 34px;
    width: var(--indicador-largura, 0px);
    transform: translate(var(--indicador-x, 0px), -50%);
    border-radius: var(--raio-pilula);
    background: rgba(245, 241, 234, 0.055);
    border: 1px solid var(--linha);
    opacity: var(--indicador-opacidade, 0);
    transition: transform var(--dur-3) var(--curva), width var(--dur-3) var(--curva),
      opacity var(--dur-2) var(--curva);
    pointer-events: none;
  }

  .menu-cta {
    margin-left: 0.4rem;
    padding: 0.55rem 1.2rem;
    min-height: 40px;
    font-size: 0.9rem;
  }

  /* ---------- botao de menu ---------- */

  .menu-botao {
    display: none;
    width: 46px;
    height: 46px;
    background: rgba(245, 241, 234, 0.03);
    border: 1px solid var(--linha-forte);
    border-radius: var(--raio-pilula);
    position: relative;
    transition: border-color var(--dur-2) var(--curva), background var(--dur-2) var(--curva);
  }

  .menu-botao:hover {
    border-color: var(--latao-linha);
  }

  .menu-linha,
  .menu-linha::before,
  .menu-linha::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 18px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--tinta);
    transform: translateX(-50%);
    transition: transform var(--dur-3) var(--curva), opacity var(--dur-2) var(--curva),
      background var(--dur-2) var(--curva);
  }

  .menu-linha {
    top: 50%;
    margin-top: -0.75px;
  }

  .menu-linha::before {
    top: -6px;
  }

  .menu-linha::after {
    top: 6px;
  }

  .menu-botao[aria-expanded='true'] .menu-linha {
    background: transparent;
  }

  .menu-botao[aria-expanded='true'] .menu-linha::before {
    transform: translateX(-50%) translateY(6px) rotate(45deg);
    background: var(--latao);
  }

  .menu-botao[aria-expanded='true'] .menu-linha::after {
    transform: translateX(-50%) translateY(-6px) rotate(-45deg);
    background: var(--latao);
  }

  /* ---------- painel movel ---------- */

  @media (max-width: 900px) {
    .menu-botao {
      display: block;
    }

    .menu-indicador {
      display: none;
    }

    /* Ancorado no proprio cabecalho: acompanha a altura dele, que encolhe ao rolar. */
    .menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: rgba(13, 12, 10, 0.95);
      -webkit-backdrop-filter: blur(28px) saturate(1.3);
      backdrop-filter: blur(28px) saturate(1.3);
      border-bottom: 1px solid var(--linha-forte);
      box-shadow: var(--sombra-3);
      padding: 0.75rem var(--calha) 1.6rem;
      clip-path: inset(0 0 100% 0);
      opacity: 0;
      pointer-events: none;
      transition: clip-path var(--dur-3) var(--curva), opacity var(--dur-2) var(--curva);
    }

    .menu.aberto {
      clip-path: inset(0 0 0 0);
      opacity: 1;
      pointer-events: auto;
    }

    .menu-item {
      padding: 1rem 0.25rem;
      font-size: 1.08rem;
      border-radius: 0;
      border-bottom: 1px solid var(--linha);
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity var(--dur-3) var(--curva), transform var(--dur-3) var(--curva),
        color var(--dur-2) var(--curva);
    }

    .menu.aberto .menu-item {
      opacity: 1;
      transform: none;
    }

    .menu.aberto .menu-item:nth-child(2) { transition-delay: 0.05s; }
    .menu.aberto .menu-item:nth-child(3) { transition-delay: 0.1s; }
    .menu.aberto .menu-item:nth-child(4) { transition-delay: 0.15s; }
    .menu.aberto .menu-item:nth-child(5) { transition-delay: 0.2s; }

    .menu-cta {
      margin: 1.25rem 0 0;
      justify-content: center;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity var(--dur-3) var(--curva) 0.24s,
        transform var(--dur-3) var(--curva) 0.24s;
    }

    .menu.aberto .menu-cta {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-item,
    .menu-cta,
    .menu-indicador,
    .selo-batuta {
      transition: none;
    }
  }
</style>

<script>
  const cabecalho = document.querySelector<HTMLElement>('[data-cabecalho]');
  const botao = cabecalho?.querySelector<HTMLButtonElement>('[data-menu-botao]');
  const menu = document.getElementById('menu-principal');

  function fecharMenu() {
    botao?.setAttribute('aria-expanded', 'false');
    menu?.classList.remove('aberto');
  }

  botao?.addEventListener('click', () => {
    const aberto = botao.getAttribute('aria-expanded') === 'true';
    botao.setAttribute('aria-expanded', String(!aberto));
    menu?.classList.toggle('aberto', !aberto);
  });

  menu?.addEventListener('click', (evento) => {
    if ((evento.target as HTMLElement).closest('a')) fecharMenu();
  });

  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape') fecharMenu();
  });

  // Pilula deslizante: seque o item sob o ponteiro, e volta para a pagina atual.
  const indicador = menu?.querySelector<HTMLElement>('[data-indicador]');
  const itens = Array.from(menu?.querySelectorAll<HTMLAnchorElement>('[data-item]') ?? []);
  const itemAtual = itens.find((item) => item.getAttribute('aria-current') === 'page');

  function moverIndicador(destino: HTMLElement | undefined, visivel: boolean) {
    if (!indicador || !menu) return;
    if (!destino || !visivel) {
      indicador.style.setProperty('--indicador-opacidade', '0');
      return;
    }
    const caixaMenu = menu.getBoundingClientRect();
    const caixa = destino.getBoundingClientRect();
    indicador.style.setProperty('--indicador-x', `${caixa.left - caixaMenu.left}px`);
    indicador.style.setProperty('--indicador-largura', `${caixa.width}px`);
    indicador.style.setProperty('--indicador-opacidade', '1');
  }

  if (indicador && window.matchMedia('(min-width: 901px)').matches) {
    moverIndicador(itemAtual, Boolean(itemAtual));
    for (const item of itens) {
      item.addEventListener('pointerenter', () => moverIndicador(item, true));
      item.addEventListener('focus', () => moverIndicador(item, true));
    }
    menu?.addEventListener('pointerleave', () => moverIndicador(itemAtual, Boolean(itemAtual)));
    window.addEventListener(
      'resize',
      () => moverIndicador(itemAtual, Boolean(itemAtual)),
      { passive: true }
    );
  }
</script>
