---
// Um so display no site inteiro: Fraunces variavel, com eixo de tamanho optico.
// Instrument Sans para interface e texto, Geist Mono para codigo e micro-rotulos.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';

// Precarga dos cortes latinos que pintam o primeiro quadro.
import frauncesLatino from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import instrumentLatino from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descricao: string;
}

const { titulo, descricao } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0908" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatino} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrumentLatino} crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="pular-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="fio-mestre" data-progresso aria-hidden="true"></div>
    <Nav />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <div class="grao" aria-hidden="true"></div>
    <script>
      import '../scripts/regencia.ts';
    </script>
  </body>
</html>
