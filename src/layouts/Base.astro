---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import frauncesLatino from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import instrumentLatino from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import {localeFor,localize,locales,languageTag,ui} from '../data/i18n';
interface Props { titulo?: string; descricao?: string; }
const locale=localeFor(Astro.url.pathname),text=ui(locale);
const {titulo='Orkastery',descricao=text.indexDescription}=Astro.props;
const origin='https://orkastery.com';
---
<!doctype html>
<html lang={languageTag[locale]}>
<head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1" />
 <title>{titulo}</title>
 <meta name="description" content={descricao} />
 <link rel="canonical" href={origin+Astro.url.pathname} />
 {locales.map(l=><link rel="alternate" hreflang={languageTag[l]} href={origin+localize(Astro.url.pathname,l)} />)}
 <link rel="alternate" hreflang="x-default" href={origin+localize(Astro.url.pathname,'pt')} />
 <meta property="og:title" content={titulo} />
 <meta property="og:description" content={descricao} />
 <meta property="og:type" content="website" />
 <meta property="og:url" content={origin+Astro.url.pathname} />
 <meta property="og:locale" content={{pt:'pt_BR',en:'en_US',es:'es_ES'}[locale]} />
 <meta property="og:image" content={origin+'/og.png'} />
 <meta name="twitter:card" content="summary_large_image" />
 <meta name="theme-color" content="#0a0908" />
 <link rel="icon" href="/favicon.ico" sizes="32x32" />
 <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
 <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
 <link rel="manifest" href="/site.webmanifest" />
 <link rel="preload" as="font" type="font/woff2" href={frauncesLatino} crossorigin />
 <link rel="preload" as="font" type="font/woff2" href={instrumentLatino} crossorigin />

</head>
<body>
 <a class="skip-content" href="#conteudo">{text.skip}</a>
 <Nav />
 <main id="conteudo"><slot /></main>
 <Footer />
</body>
</html>
<style>
.skip-content{position:fixed;z-index:1000;left:1rem;top:1rem;transform:translateY(-200%);padding:1rem;background:var(--tinta,var(--texto));color:var(--poco,var(--fundo));}
.skip-content:focus{transform:none;}
</style>
