---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import geistLatino from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import hankenLatino from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {localeFor,localize,locales,languageTag,ui,withBase} from '../data/i18n';
import {releaseDaBase,textoDaFaixa,versaoDaBuild} from '../lib/previa.mjs';
interface Props { titulo?: string; descricao?: string; }
const locale=localeFor(Astro.url.pathname),text=ui(locale);
const {titulo='Orkastery',descricao=text.indexDescription}=Astro.props;
const origin='https://orkastery.com';
// Prévia de release (SITE_BASE em /releasevalidation/<release>/): fora dos buscadores e com a faixa no topo.
const release=releaseDaBase(import.meta.env.BASE_URL),sha=release?versaoDaBuild().sha:null;
---
<!doctype html>
<html lang={languageTag[locale]}>
<head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1" />{release&&<meta name="robots" content="noindex, nofollow" />}
 <title>{titulo}</title>
 <meta name="description" content={descricao} />
 <link rel="canonical" href={origin+Astro.url.pathname} />
 {locales.map(l=><link rel="alternate" hreflang={languageTag[l]} href={origin+localize(Astro.url.pathname,l)} />)}
 <link rel="alternate" hreflang="x-default" href={origin+localize(Astro.url.pathname,'pt')} />
 <meta property="og:title" content={titulo} />
 <meta property="og:description" content={descricao} />
 <meta property="og:type" content="website" />
 <meta property="og:url" content={origin+Astro.url.pathname} />
 <meta property="og:locale" content={{pt:'pt_BR',en:'en_US'}[locale]} />
 <meta property="og:image" content={origin+withBase('/og.png')} />
 <meta name="twitter:card" content="summary_large_image" />
 <meta name="theme-color" content="#EEF0F2" />
 <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
 <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
 <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
 <link rel="manifest" href={withBase('/site.webmanifest')} />
 <link rel="preload" as="font" type="font/woff2" href={geistLatino} crossorigin />
 <link rel="preload" as="font" type="font/woff2" href={hankenLatino} crossorigin />
</head>
<body>{release&&<div class="previa-faixa" role="note" lang="pt-BR" data-previa={release} data-sha={sha}>{textoDaFaixa(release)} · <code title={sha}>{sha?.slice(0,7)}</code></div>}
 <a class="pular" href="#conteudo">{text.skip}</a>
 <div class="pagina">
  <SiteHeader />
  <main id="conteudo" tabindex="-1"><slot /></main>
  <SiteFooter />
 </div>
</body>
</html>
<script>
 import '../scripts/moldura.ts';
</script>
<style>
.previa-faixa{padding:8px 16px;font:500 13px/1.4 var(--fonte-texto);text-align:center;color:var(--tinta);background:var(--acento-suave);border-bottom:1px dashed var(--acento-texto)}
.previa-faixa code{font:inherit;font-family:var(--fonte-mono);background:none;padding:0}
main:focus{outline:none}
</style>
