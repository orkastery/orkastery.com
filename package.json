{
  "name": "orkastery-site",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "Portal da Orkastery: a marca opensource e o produto Ork, a AI Software Factory",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "tokens": "node scripts/design-tokens.mjs",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:redirecionamentos": "node scripts/check-redirecionamentos.mjs",
    "check:public": "node scripts/check-public.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:code": "node scripts/check-code.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:previa": "node scripts/check-previa.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "check:fidelity": "node scripts/check-fidelity.mjs",
    "test:docs": "node scripts/docs-schema.test.mjs && node scripts/docs-check.test.mjs",
    "test:redirecionamentos": "node scripts/redirecionamentos.test.mjs",
    "test:code": "node scripts/code-format.test.mjs",
    "test:design": "node scripts/design-check.test.mjs && node --experimental-strip-types scripts/home-state.test.mjs",
    "test:previa": "node scripts/previa.test.mjs",
    "test:publicar": "node scripts/publicar.test.mjs",
    "prebuild": "npm run docs:check",
    "postbuild": "npm run check:links && npm run check:i18n && npm run check:redirecionamentos && npm run check:public && npm run check:content && npm run test:docs && npm run test:redirecionamentos && npm run test:code && npm run check:code && npm run check:design && npm run test:design && npm run check:previa && npm run test:previa"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "^5.13.0",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "parse5": "7.3.0"
  }
}
